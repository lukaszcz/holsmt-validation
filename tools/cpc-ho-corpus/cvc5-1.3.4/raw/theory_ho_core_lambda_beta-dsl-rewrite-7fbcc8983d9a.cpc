(
(define @t1 () (@var "x" Int))
(define @t2 () (_ (lambda (@list @t1) (+ @t1 1)) 2))
(define @t3 () (distinct @t2 3))
(define @t4 () (+ 2 1))
(define @t5 () (= @t2 3))
(define @t6 () (not @t5))
(assume @p1 @t3)
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule evaluate :args ((= 3 3)))
(step @p4 :rule refl :args (3))
(step @p5 :rule evaluate :args (@t4))
(step @p6 :rule beta-reduce :args ((= @t2 @t4)))
(step @p7 :rule trans :premises (@p6 @p5))
(step @p8 :rule cong :premises (@p7 @p4) :args (@t5))
(step @p9 :rule trans :premises (@p8 @p3))
(step @p10 :rule cong :premises (@p9) :args (@t6))
(step @p11 :rule trans :premises (@p10 @p2))
(step @p12 :rule distinct-elim :args ((= @t3 @t6)))
(step @p13 :rule trans :premises (@p12 @p11))
(step @p14 false :rule eq_resolve :premises (@p1 @p13))
)