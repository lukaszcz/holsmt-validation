(
(declare-const f (-> Bool Bool))
(declare-const g (-> Bool Bool))
(define @t1 () (@var "x" Bool))
(define @t2 () (g @t1))
(define @t3 () (f @t1))
(define @t4 () (@list @t1))
(define @t5 () (forall @t4 (= @t3 @t2)))
(define @t6 () (lambda @t4 @t2))
(define @t7 () (lambda @t4 @t3))
(define @t8 () (distinct @t7 @t6))
(define @t9 () (= @t7 @t6))
(define @t10 () (not @t9))
(define @t11 () (@const 0 Bool))
(define @t12 () (@purify @t11))
(define @t13 () (f @t12))
(define @t14 () (g @t12))
(define @t15 () (g @t11))
(define @t16 () (f @t11))
(define @t17 () (= @t16 @t15))
(define @t18 () (not @t17))
(define @t19 () (= f g))
(define @t20 () (or @t19 @t18))
(define @t21 () (= @t14 @t13))
(define @t22 () (= @t13 @t14))
(assume @p1 @t5)
(assume @p2 @t8)
(step @p3 :rule lambda-elim :args ((= @t6 g)))
(step @p4 :rule lambda-elim :args ((= @t7 f)))
(step @p5 :rule cong :premises (@p4 @p3) :args (@t9))
(step @p6 :rule cong :premises (@p5) :args (@t10))
(step @p7 :rule distinct-elim :args ((= @t8 @t10)))
(step @p8 :rule trans :premises (@p7 @p6))
(step @p9 :rule eq_resolve :premises (@p2 @p8))
(step @p10 :rule eq-symm :args (@t13 @t14))
(step @p11 :rule eq-refl :args (@t11))
(step @p12 :rule skolem_intro :args (@t12))
(step @p13 :rule refl :args (@t11))
(step @p14 :rule cong :premises (@p13 @p12) :args ((= @t11 @t12)))
(step @p15 :rule trans :premises (@p14 @p11))
(step @p16 :rule true_elim :premises (@p15))
(step @p17 :rule cong :premises (@p16) :args (@t15))
(step @p18 :rule cong :premises (@p16) :args (@t16))
(step @p19 :rule cong :premises (@p18 @p17) :args (@t17))
(step @p20 :rule trans :premises (@p19 @p10))
(step @p21 :rule cong :premises (@p20) :args (@t18))
(step @p22 :rule refl :args (@t19))
(step @p23 :rule nary_cong :premises (@p22 @p21) :args (@t20))
; WARNING: add trust step for TRUST
; trust TRUST THEORY_LEMMA
(step @p24 :rule trust :premises () :args (@t20))
(step @p25 :rule eq_resolve :premises (@p24 @p23))
(step @p26 :rule chain_m_resolution :premises (@p25 @p9) :args ((not @t21) (@list true) (@list @t19)))
(step @p27 :rule refl :args (@t5))
(step @p28 :rule cong :premises (@p27 @p10) :args ((=> @t5 @t22)))
(assume-push @p36 @t5)
(step @p30 :rule instantiate :premises (@p1) :args ((@list @t12)))
(step-pop @p37 :rule scope :premises (@p30))
(step @p31 :rule process_scope :premises (@p37) :args (@t22))
(step @p33 :rule eq_resolve :premises (@p31 @p28))
(step @p34 :rule implies_elim :premises (@p33))
(step @p35 false :rule chain_m_resolution :premises (@p34 @p26 @p1) :args (false (@list true false) (@list @t21 @t5)))
)