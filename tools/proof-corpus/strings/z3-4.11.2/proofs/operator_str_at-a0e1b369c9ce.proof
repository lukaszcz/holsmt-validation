((set-logic QF_S)
(proof
(let ((?x26 (str.at "abc" 1)))
 (let (($x28 (= ?x26 "b")))
 (let (($x29 (not $x28)))
 (let (($x62 (= $x29 false)))
 (let ((@x61 (rewrite (= (not true) false))))
 (let (($x57 (not true)))
 (let (($x58 (= $x29 $x57)))
 (let (($x55 (= $x28 true)))
 (let ((@x68 (trans (rewrite (= ?x26 (seq.unit (_ Char 98)))) (rewrite (= (seq.unit (_ Char 98)) "b")) $x28)))
 (let ((@x74 (trans (monotonicity @x68 (= $x28 (= "b" "b"))) (rewrite (= (= "b" "b") true)) $x55)))
 (let ((@x30 (asserted $x29)))
 (mp @x30 (trans (monotonicity @x74 $x58) @x61 $x62) false))))))))))))))

