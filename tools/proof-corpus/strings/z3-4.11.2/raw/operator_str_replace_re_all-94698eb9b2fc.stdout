unsat
((set-logic QF_S)
(proof
(let ((?x28 (str.replace_re_all "aba" (str.to_re "a") "X")))
 (let (($x29 (= ?x28 ?x28)))
 (let (($x30 (not $x29)))
 (let (($x56 (= $x30 false)))
 (let ((@x55 (rewrite (= (not true) false))))
 (let ((@x61 (trans (monotonicity (rewrite (= $x29 true)) (= $x30 (not true))) @x55 $x56)))
 (let ((@x31 (asserted $x30)))
 (mp @x31 @x61 false))))))))))

