unsat
((set-logic QF_S)
(proof
(let ((?x25 (str.len "abc")))
 (let (($x27 (= ?x25 3)))
 (let (($x28 (not $x27)))
 (let (($x59 (= $x28 false)))
 (let ((@x58 (rewrite (= (not true) false))))
 (let (($x54 (not true)))
 (let (($x55 (= $x28 $x54)))
 (let (($x52 (= $x27 true)))
 (let ((@x51 (rewrite (= (= 3 3) true))))
 (let ((@x64 (trans (monotonicity (rewrite $x27) (= $x27 (= 3 3))) @x51 $x52)))
 (let ((@x29 (asserted $x28)))
 (mp @x29 (trans (monotonicity @x64 $x55) @x58 $x59) false))))))))))))))

