{
  "cases": [
    {
      "description": "Symbolic right-concatenation contradiction.",
      "drafting_probe": "concat",
      "expected_result": "unsat",
      "id": "draft_concat",
      "operators": [
        "str.++"
      ],
      "path": "inputs/draft_concat.smt2"
    },
    {
      "description": "Concat/length arithmetic contradiction.",
      "drafting_probe": "length",
      "expected_result": "unsat",
      "id": "draft_length",
      "operators": [
        "str.++",
        "str.len"
      ],
      "path": "inputs/draft_length.smt2"
    },
    {
      "description": "Range membership contradicting lexicographic order.",
      "drafting_probe": "regex-membership",
      "expected_result": "unsat",
      "id": "draft_regex_membership",
      "operators": [
        "str.in_re",
        "re.range",
        "str.<"
      ],
      "path": "inputs/draft_regex_membership.smt2"
    },
    {
      "description": "Length-one substring identity.",
      "drafting_probe": "substr",
      "expected_result": "unsat",
      "id": "draft_substr",
      "operators": [
        "str.len",
        "str.substr"
      ],
      "path": "inputs/draft_substr.smt2"
    },
    {
      "description": "A string contains its appended suffix.",
