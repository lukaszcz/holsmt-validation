((set-logic QF_S)
(proof
(let ((?x26 (str.to_re "b")))
(let ((?x24 (str.to_re "a")))
(let ((?x27 (re.union ?x24 ?x26)))
(let (($x28 (str.in_re "a" ?x27)))
(let (($x29 (not $x28)))
(let (($x76 (= $x29 false)))
(let ((@x75 (rewrite (= (not true) false))))
(let (($x71 (not true)))
(let (($x72 (= $x29 $x71)))
(let (($x69 (= $x28 true)))
(let ((@x84 (trans (monotonicity (rewrite (= ?x27 ?x27)) (= $x28 $x28)) (rewrite $x69) $x69)))
(let ((@x30 (asserted $x29)))
(mp @x30 (trans (monotonicity @x84 $x72) @x75 $x76) false)))))))))))))))

