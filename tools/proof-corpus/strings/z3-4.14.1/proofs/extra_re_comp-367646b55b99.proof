((set-logic QF_S)
(proof
(let ((?x26 (re.comp (str.to_re "a"))))
(let (($x27 (str.in_re "b" ?x26)))
(let (($x28 (not $x27)))
(let (($x54 (= $x28 false)))
(let ((@x53 (rewrite (= (not true) false))))
(let ((@x59 (trans (monotonicity (rewrite (= $x27 true)) (= $x28 (not true))) @x53 $x54)))
(let ((@x29 (asserted $x28)))
(mp @x29 @x59 false))))))))))

