unsat
((set-logic QF_S)
(proof
(let ((?x27 (str.replace_re_all "aba" (str.to_re "a") "X")))
(let (($x28 (= ?x27 ?x27)))
(let (($x29 (not $x28)))
(let (($x55 (= $x29 false)))
(let ((@x54 (rewrite (= (not true) false))))
(let ((@x60 (trans (monotonicity (rewrite (= $x28 true)) (= $x29 (not true))) @x54 $x55)))
(let ((@x30 (asserted $x29)))
(mp @x30 @x60 false))))))))))

