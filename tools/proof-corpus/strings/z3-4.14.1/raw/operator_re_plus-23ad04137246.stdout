unsat
((set-logic QF_S)
(proof
(let ((?x25 (str.to_re "a")))
(let ((?x26 (re.+ ?x25)))
(let (($x27 (str.in_re "aaa" ?x26)))
(let (($x28 (not $x27)))
(let (($x82 (= $x28 false)))
(let ((@x81 (rewrite (= (not true) false))))
(let (($x77 (not true)))
(let (($x78 (= $x28 $x77)))
(let (($x75 (= $x27 true)))
(let ((@x91 (monotonicity (rewrite (= ?x26 (re.++ ?x25 (re.* ?x25)))) (= $x27 (str.in_re "aaa" (re.++ ?x25 (re.* ?x25)))))))
(let ((@x94 (trans @x91 (rewrite (= (str.in_re "aaa" (re.++ ?x25 (re.* ?x25))) true)) $x75)))
(let ((@x29 (asserted $x28)))
(mp @x29 (trans (monotonicity @x94 $x78) @x81 $x82) false)))))))))))))))

