((set-logic QF_S)
(proof
(let ((?x25 (str.to_int "123")))
 (let (($x27 (= ?x25 123)))
 (let (($x28 (not $x27)))
 (let (($x210 (= $x28 false)))
 (let ((@x209 (rewrite (= (not true) false))))
 (let (($x205 (not true)))
 (let (($x206 (= $x28 $x205)))
 (let (($x203 (= $x27 true)))
 (let ((@x202 (rewrite (= (= 123 123) true))))
 (let ((@x215 (trans (monotonicity (rewrite $x27) (= $x27 (= 123 123))) @x202 $x203)))
 (let ((@x29 (asserted $x28)))
 (mp @x29 (trans (monotonicity @x215 $x206) @x209 $x210) false))))))))))))))

