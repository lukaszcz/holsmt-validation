((set-logic QF_FP)
(proof
(let ((?x28 (fp (_ bv0 1) (_ bv3 3) (_ bv0 4))))
 (let ((?x26 (fp (_ bv0 1) (_ bv4 3) (_ bv0 4))))
 (let ((?x29 (fp.sub roundNearestTiesToEven ?x26 ?x28)))
 (let (($x30 (= ?x29 ?x28)))
 (let (($x31 (not $x30)))
 (let ((@x40 (rewrite (= ?x28 (fp #b0 #b011 #x0)))))
 (let ((?x44 (fp.neg (fp #b0 #b011 #x0))))
 (let ((?x45 (fp.add roundNearestTiesToEven (fp #b0 #b100 #x0) ?x44)))
 (let ((?x55 (fp.add roundNearestTiesToEven (fp #b0 #b100 #x0) (fp #b1 #b011 #x0))))
 (let ((@x34 (rewrite (= roundNearestTiesToEven roundNearestTiesToEven))))
 (let ((@x57 (monotonicity @x34 (rewrite (= (fp #b0 #b100 #x0) (fp #b0 #b100 #x0))) (rewrite (= ?x44 (fp #b1 #b011 #x0))) (= ?x45 ?x55))))
 (let ((@x61 (trans @x57 (rewrite (= ?x55 (fp #b0 #b011 #x0))) (= ?x45 (fp #b0 #b011 #x0)))))
 (let ((@x47 (rewrite (= (fp.sub roundNearestTiesToEven (fp #b0 #b100 #x0) (fp #b0 #b011 #x0)) ?x45))))
 (let ((@x43 (monotonicity @x34 (rewrite (= ?x26 (fp #b0 #b100 #x0))) @x40 (= ?x29 (fp.sub roundNearestTiesToEven (fp #b0 #b100 #x0) (fp #b0 #b011 #x0))))))
 (let ((@x66 (monotonicity (trans (trans @x43 @x47 (= ?x29 ?x45)) @x61 (= ?x29 (fp #b0 #b011 #x0))) @x40 (= $x30 (= (fp #b0 #b011 #x0) (fp #b0 #b011 #x0))))))
 (let ((@x70 (trans @x66 (rewrite (= (= (fp #b0 #b011 #x0) (fp #b0 #b011 #x0)) true)) (= $x30 true))))
 (let ((@x77 (trans (monotonicity @x70 (= $x31 (not true))) (rewrite (= (not true) false)) (= $x31 false))))
 (mp (asserted $x31) @x77 false))))))))))))))))))))

