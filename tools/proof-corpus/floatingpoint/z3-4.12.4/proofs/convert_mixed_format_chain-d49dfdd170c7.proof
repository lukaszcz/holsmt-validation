 (let ((@x68 (trans @x64 (rewrite (= (= (fp #b0 #b011 #x1) (fp #b0 #b011 #x1)) true)) (= $x34 true))))
 (let ((@x75 (trans (monotonicity @x68 (= $x35 (not true))) (rewrite (= (not true) false)) (= $x35 false))))
