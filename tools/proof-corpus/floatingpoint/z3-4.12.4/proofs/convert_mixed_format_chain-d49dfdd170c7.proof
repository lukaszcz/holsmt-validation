 (let ((@x46 (monotonicity (rewrite (= roundNearestTiesToEven roundNearestTiesToEven)) (rewrite (= ?x28 (/ 33.0 32.0))) (= ?x29 ((_ to_fp 4 7) roundNearestTiesToEven (/ 33.0 32.0))))))
 (let ((@x51 (trans @x46 (rewrite (= ((_ to_fp 4 7) roundNearestTiesToEven (/ 33.0 32.0)) (fp #b0 #x7 #b000010))) (= ?x29 (fp #b0 #x7 #b000010)))))
