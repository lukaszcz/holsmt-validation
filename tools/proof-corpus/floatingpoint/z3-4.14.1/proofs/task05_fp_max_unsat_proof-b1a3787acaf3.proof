(let (($x30 (not $x29)))
(let ((@x37 (rewrite (= ?x27 (fp #b0 #b100 #x0)))))
(let ((@x40 (monotonicity (rewrite (= ?x25 (fp #b0 #b011 #x0))) @x37 (= ?x28 (fp.max (fp #b0 #b011 #x0) (fp #b0 #b100 #x0))))))
(let ((@x44 (trans @x40 (rewrite (= (fp.max (fp #b0 #b011 #x0) (fp #b0 #b100 #x0)) (fp #b0 #b100 #x0))) (= ?x28 (fp #b0 #b100 #x0)))))
