((set-logic QF_FPLRA)
(proof
(let ((?x28 (fp (_ bv0 1) (_ bv3 3) (_ bv1 4))))
 (let ((?x29 ((_ to_fp 4 7) roundNearestTiesToEven ?x28)))
 (let ((?x30 ((_ to_fp 3 5) roundNearestTiesToAway ?x29)))
 (let (($x31 (= ?x30 ?x28)))
 (let (($x32 (not $x31)))
 (let ((@x40 (rewrite (= ?x28 (fp #b0 #b011 #x1)))))
 (let ((@x43 (monotonicity (rewrite (= roundNearestTiesToEven roundNearestTiesToEven)) @x40 (= ?x29 ((_ to_fp 4 7) roundNearestTiesToEven (fp #b0 #b011 #x1))))))
 (let ((@x48 (trans @x43 (rewrite (= ((_ to_fp 4 7) roundNearestTiesToEven (fp #b0 #b011 #x1)) (fp #b0 #x7 #b000100))) (= ?x29 (fp #b0 #x7 #b000100)))))
 (let ((@x51 (monotonicity (rewrite (= roundNearestTiesToAway roundNearestTiesToAway)) @x48 (= ?x30 ((_ to_fp 3 5) roundNearestTiesToAway (fp #b0 #x7 #b000100))))))
 (let ((@x55 (trans @x51 (rewrite (= ((_ to_fp 3 5) roundNearestTiesToAway (fp #b0 #x7 #b000100)) (fp #b0 #b011 #x1))) (= ?x30 (fp #b0 #b011 #x1)))))
 (let ((@x62 (trans (monotonicity @x55 @x40 (= $x31 (= (fp #b0 #b011 #x1) (fp #b0 #b011 #x1)))) (rewrite (= (= (fp #b0 #b011 #x1) (fp #b0 #b011 #x1)) true)) (= $x31 true))))
 (let ((@x69 (trans (monotonicity @x62 (= $x32 (not true))) (rewrite (= (not true) false)) (= $x32 false))))
 (mp (asserted $x32) @x69 false)))))))))))))))

