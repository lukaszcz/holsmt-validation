 (let ((@x43 (trans @x40 (rewrite (= ((_ fp.to_sbv 4) roundTowardZero (fp #b1 #b100 #x8)) (_ bv13 4))) $x30)))
 (let ((@x50 (trans (monotonicity @x43 (= $x30 (= (_ bv13 4) (_ bv13 4)))) (rewrite (= (= (_ bv13 4) (_ bv13 4)) true)) (= $x30 true))))
