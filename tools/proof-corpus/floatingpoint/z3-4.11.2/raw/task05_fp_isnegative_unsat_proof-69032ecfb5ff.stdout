 (let ((@x29 (and-elim @x27 $x25)))
 (let ((@x153 (monotonicity @x147 (rewrite (= (_ bv1 1) (mkbv true))) (= (= ?x31 (_ bv1 1)) (= ?x143 (mkbv true))))))
 (let ((@x157 (trans @x153 (rewrite (= (= ?x143 (mkbv true)) k!80)) (= (= ?x31 (_ bv1 1)) k!80))))
 (let (($x47 (= ?x31 (_ bv1 1))))
