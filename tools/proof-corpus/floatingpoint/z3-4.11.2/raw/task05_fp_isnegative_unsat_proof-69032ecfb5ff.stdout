(proof
(let (($x165 (not k!80)))
 (let ((?x143 (mkbv k!80)))
 (let ((?x89 (mkbv k!10 k!20 k!30 k!40 k!50 k!60 k!70 k!80)))
 (let ((?x118 ((_ extract 7 7) ?x89)))
 (let ((@x142 (monotonicity (rewrite (= k!00 ?x89)) (= ((_ extract 7 7) k!00) ?x118))))
 (let ((@x147 (trans @x142 (rewrite (= ?x118 ?x143)) (= ((_ extract 7 7) k!00) ?x143))))
 (let ((@x164 (monotonicity @x147 (rewrite (= (_ bv0 1) (mkbv false))) (= (= ((_ extract 7 7) k!00) (_ bv0 1)) (= ?x143 (mkbv false))))))
 (let ((@x169 (trans @x164 (rewrite (= (= ?x143 (mkbv false)) $x165)) (= (= ((_ extract 7 7) k!00) (_ bv0 1)) $x165))))
 (let ((?x31 ((_ extract 7 7) k!00)))
 (let (($x60 (= ?x31 (_ bv0 1))))
 (let (($x45 (and (= ((_ extract 6 4) k!00) (_ bv7 3)) (not (= ((_ extract 3 0) k!00) (_ bv0 4))))))
 (let (($x48 (not $x45)))
 (let (($x61 (and $x48 $x60)))
 (let ((?x33 ((_ extract 3 0) k!00)))
 (let ((?x32 ((_ extract 6 4) k!00)))
 (let ((?x34 (fp ?x31 ?x32 ?x33)))
 (let (($x57 (fp.isPositive ?x34)))
 (let ((@x65 (trans (monotonicity (rewrite (= x ?x34)) (= (fp.isPositive x) $x57)) (rewrite (= $x57 $x61)) (= (fp.isPositive x) $x61))))
 (let (($x25 (fp.isPositive x)))
