unsat
((set-logic QF_FP)
(declare-fun k!00 () (_ BitVec 8))
(proof
(let (($x50 (and (= ((_ extract 6 4) k!00) (_ bv7 3)) (not (= ((_ extract 3 0) k!00) (_ bv0 4))))))
 (let (($x52 (and (not $x50) false)))
 (let ((?x30 ((_ extract 3 0) k!00)))
 (let ((?x29 ((_ extract 6 4) k!00)))
