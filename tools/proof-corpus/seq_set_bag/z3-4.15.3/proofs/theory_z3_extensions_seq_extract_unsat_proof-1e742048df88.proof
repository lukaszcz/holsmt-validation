((set-logic ALL)
(proof
(let ((?x24 (seq.unit 7)))
(let ((?x27 (seq.extract ?x24 0 1)))
(let (($x28 (= ?x27 ?x24)))
(let (($x29 (not $x28)))
(let ((@x36 (rewrite (= (seq.at ?x24 0) ?x24))))
(let ((@x40 (monotonicity (trans (rewrite (= ?x27 (seq.at ?x24 0))) @x36 $x28) (= $x28 (= ?x24 ?x24)))))
(let ((@x44 (trans @x40 (rewrite (= (= ?x24 ?x24) true)) (= $x28 true))))
(let ((@x51 (trans (monotonicity @x44 (= $x29 (not true))) (rewrite (= (not true) false)) (= $x29 false))))
(mp (and-elim (asserted (and $x28 $x29)) $x29) @x51 false)))))))))))

