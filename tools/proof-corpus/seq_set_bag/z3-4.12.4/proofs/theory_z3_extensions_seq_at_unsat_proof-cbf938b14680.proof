((set-logic ALL)
(proof
(let (($x40 (not true)))
 (let ((?x25 (seq.unit 7)))
 (let (($x28 (= (seq.at ?x25 0) ?x25)))
 (let (($x29 (not $x28)))
 (let ((@x39 (trans (monotonicity (rewrite $x28) (= $x28 (= ?x25 ?x25))) (rewrite (= (= ?x25 ?x25) true)) (= $x28 true))))
 (let ((@x46 (trans (monotonicity @x39 (= $x29 $x40)) (rewrite (= $x40 false)) (= $x29 false))))
 (mp (and-elim (asserted (and $x28 $x29)) $x29) @x46 false)))))))))

