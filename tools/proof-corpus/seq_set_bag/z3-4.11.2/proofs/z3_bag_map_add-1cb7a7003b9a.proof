 (let ((@x46 (rewrite (= (store ?x35 3 (+ x 3)) ?x43))))
 (let ((@x42 (trans (rewrite (= ?x30 (store ?x35 3 (+ x 3)))) @x46 (= ?x30 ?x43))))
 (let ((@x52 (trans (monotonicity @x42 (= ?x31 ?x45)) (rewrite (= ?x45 ?x40)) (= ?x31 ?x40))))
 (let ((@x61 (trans (monotonicity @x52 (= $x33 (= ?x40 4))) (rewrite (= (= ?x40 4) $x57)) (= $x33 $x57))))
 (let ((@x62 (mp (asserted $x33) @x61 $x57)))
 (let ((@x74 (monotonicity (mp @x62 (rewrite (= $x57 $x57)) $x57) (= (>= x 2) (>= 1 2)))))
 (let ((@x79 (trans @x74 (rewrite (= (>= 1 2) false)) (= (>= x 2) false))))
 (let (($x64 (>= x 2)))
 (let ((@x65 (asserted $x64)))
