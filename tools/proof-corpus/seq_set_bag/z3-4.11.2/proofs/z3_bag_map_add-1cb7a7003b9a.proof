((set-logic ALL)
(proof
(let (($x57 (= x 1)))
 (let ((?x30 ((_ map + ) (store a 3 x) (store b 3 3))))
 (let ((?x31 (select ?x30 3)))
 (let (($x33 (= ?x31 4)))
 (let ((?x40 (+ 3 x)))
 (let ((?x35 ((_ map + ) a b)))
