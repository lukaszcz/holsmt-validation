((set-logic ALL)
(proof
(let ((?x29 (seq.unit 7)))
(let ((?x26 (lambda ((i Int) (x Int) )(! (+ i x) :qid k!5))
))
(let ((?x30 (seq.mapi ?x26 0 ?x29)))
(let (($x31 (= ?x30 ?x29)))
(let (($x32 (not $x31)))
(let ((@x48 (rewrite (= (seq.unit (select ?x26 0 7)) ?x29))))
(let ((@x40 (trans (rewrite (= ?x30 (seq.unit (select ?x26 0 7)))) @x48 $x31)))
(let ((@x51 (trans (monotonicity @x40 (= $x31 (= ?x29 ?x29))) (rewrite (= (= ?x29 ?x29) true)) (= $x31 true))))
(let ((@x58 (trans (monotonicity @x51 (= $x32 (not true))) (rewrite (= (not true) false)) (= $x32 false))))
(mp (and-elim (asserted (and $x31 $x32)) $x32) @x58 false))))))))))))

