(set-option :produce-proofs true)
(set-logic ALL)
(declare-const u (Array Int (Array Int Int)))
(declare-const r (Array Int (Array Int Int)))
(declare-const a Int)
(assert (forall ((x Int))
  (= (select r x)
     (lambda ((y Int))
       (select (select u x) y)))))
(assert (distinct
  (select r a)
  (lambda ((y Int)) (select (select u a) y))))
(check-sat)
(get-proof)
