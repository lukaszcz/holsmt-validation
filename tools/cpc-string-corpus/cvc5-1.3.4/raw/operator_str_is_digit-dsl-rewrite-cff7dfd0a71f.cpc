(
(define @t1 () (str.is_digit "7"))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (and true true))
(define @t5 () (<= 55 57))
(define @t6 () (str.to_code "7"))
(define @t7 () (<= @t6 57))
(define @t8 () (<= 48 55))
(define @t9 () (<= 48 @t6))
(define @t10 () (and @t9 @t7))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t5 true) :rule evaluate :args (@t5))
(step @p5 (= 57 57) :rule refl :args (57))
(step @p6 (= @t6 55) :rule evaluate :args (@t6))
(step @p7 (= @t7 @t5) :rule cong :premises (@p6 @p5) :args (@t7))
(step @p8 (= @t7 true) :rule trans :premises (@p7 @p4))
(step @p9 (= @t8 true) :rule evaluate :args (@t8))
(step @p10 (= 48 48) :rule refl :args (48))
(step @p11 (= @t9 @t8) :rule cong :premises (@p10 @p6) :args (@t9))
(step @p12 (= @t9 true) :rule trans :premises (@p11 @p9))
(step @p13 (= @t10 @t4) :rule nary_cong :premises (@p12 @p8) :args (@t10))
(step @p14 (= @t10 true) :rule trans :premises (@p13 @p3))
(step @p15 (= @t1 @t10) :rule str-is-digit-elim :args ("7"))
(step @p16 (= @t1 true) :rule trans :premises (@p15 @p14))
(step @p17 (= @t2 @t3) :rule cong :premises (@p16) :args (@t2))
(step @p18 (= @t2 false) :rule trans :premises (@p17 @p2))
(step @p19 false :rule eq_resolve :premises (@p1 @p18))
)