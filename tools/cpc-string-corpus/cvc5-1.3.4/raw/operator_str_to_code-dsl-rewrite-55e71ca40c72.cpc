(
(define @t1 () (str.to_code "A"))
(define @t2 () (= @t1 65))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (= 65 65))
(assume @p1 @t3)
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 true) :rule evaluate :args (@t5))
(step @p4 @t5 :rule refl :args (65))
(step @p5 @t2 :rule evaluate :args (@t1))
(step @p6 (= @t2 @t5) :rule cong :premises (@p5 @p4) :args (@t2))
(step @p7 (= @t2 true) :rule trans :premises (@p6 @p3))
(step @p8 (= @t3 @t4) :rule cong :premises (@p7) :args (@t3))
(step @p9 (= @t3 false) :rule trans :premises (@p8 @p2))
(step @p10 false :rule eq_resolve :premises (@p1 @p9))
)