unsat
(
(define @t1 () (str.replace_re_all "aba" (str.to_re "a") "X"))
(define @t2 () (= @t1 @t1))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (= "XbX" "XbX"))
(define @t6 () (str.++ "" "X" "b" "X"))
(define @t7 () (= @t1 @t6))
(assume @p1 @t3)
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 true) :rule evaluate :args (@t5))
(step @p4 (= @t6 "XbX") :rule evaluate :args (@t6))
(step @p5 @t7 :rule str-replace-re-all-eval :args (@t7))
(step @p6 (= @t1 "XbX") :rule trans :premises (@p5 @p4))
(step @p7 (= @t2 @t5) :rule cong :premises (@p6 @p6) :args (@t2))
(step @p8 (= @t2 true) :rule trans :premises (@p7 @p3))
(step @p9 (= @t3 @t4) :rule cong :premises (@p8) :args (@t3))
(step @p10 (= @t3 false) :rule trans :premises (@p9 @p2))
(step @p11 false :rule eq_resolve :premises (@p1 @p10))
)
(
(define @t1 () (str.replace_re_all "aba" (str.to_re "a") "X"))
(define @t2 () (= @t1 @t1))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (= "XbX" "XbX"))
(define @t6 () (str.++ "" "X" "b" "X"))
(define @t7 () (= @t1 @t6))
(assume @p1 @t3)
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 true) :rule evaluate :args (@t5))
(step @p4 (= @t6 "XbX") :rule evaluate :args (@t6))
(step @p5 @t7 :rule str-replace-re-all-eval :args (@t7))
(step @p6 (= @t1 "XbX") :rule trans :premises (@p5 @p4))
(step @p7 (= @t2 @t5) :rule cong :premises (@p6 @p6) :args (@t2))
(step @p8 (= @t2 true) :rule trans :premises (@p7 @p3))
(step @p9 (= @t3 @t4) :rule cong :premises (@p8) :args (@t3))
(step @p10 (= @t3 false) :rule trans :premises (@p9 @p2))
(step @p11 false :rule eq_resolve :premises (@p1 @p10))
)
