unsat
(
(define @t1 () (str.in_re "abc" re.all))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (re.* re.allchar))
(define @t5 () (str.in_re "abc" @t4))
(define @t6 () (= @t5 true))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 @t6 :rule str-in-re-eval :args (@t6))
(step @p4 (= re.all @t4) :rule re-all-elim)
(step @p5 (= "abc" "abc") :rule refl :args ("abc"))
(step @p6 (= @t1 @t5) :rule cong :premises (@p5 @p4) :args (@t1))
(step @p7 (= @t1 true) :rule trans :premises (@p6 @p3))
(step @p8 (= @t2 @t3) :rule cong :premises (@p7) :args (@t2))
(step @p9 (= @t2 false) :rule trans :premises (@p8 @p2))
(step @p10 false :rule eq_resolve :premises (@p1 @p9))
)
(
(define @t1 () (str.in_re "abc" re.all))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (re.* re.allchar))
(define @t5 () (str.in_re "abc" @t4))
(define @t6 () (= @t5 true))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 @t6 :rule str-in-re-eval :args (@t6))
(step @p4 (= re.all @t4) :rule re-all-elim)
(step @p5 (= "abc" "abc") :rule refl :args ("abc"))
(step @p6 (= @t1 @t5) :rule cong :premises (@p5 @p4) :args (@t1))
(step @p7 (= @t1 true) :rule trans :premises (@p6 @p3))
(step @p8 (= @t2 @t3) :rule cong :premises (@p7) :args (@t2))
(step @p9 (= @t2 false) :rule trans :premises (@p8 @p2))
(step @p10 false :rule eq_resolve :premises (@p1 @p9))
)
