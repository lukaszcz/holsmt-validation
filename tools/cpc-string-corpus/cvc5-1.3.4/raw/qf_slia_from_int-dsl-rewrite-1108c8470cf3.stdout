unsat
(
(define @t1 () (- 0 1))
(define @t2 () (str.from_int @t1))
(define @t3 () (= @t2 ""))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= "" ""))
(define @t7 () (str.from_int -1))
(define @t8 () (+ 0 -1))
(define @t9 () (* -1 1))
(define @t10 () (+ 0 @t9))
(define @t11 () (= @t10 -1))
(define @t12 () (= @t1 -1))
(assume @p1 @t4)
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule evaluate :args (@t6))
(step @p4 @t6 :rule refl :args (""))
(step @p5 (= @t7 "") :rule evaluate :args (@t7))
(step @p6 (= @t8 -1) :rule evaluate :args (@t8))
(step @p7 (= @t9 -1) :rule evaluate :args (@t9))
(step @p8 (= 0 0) :rule refl :args (0))
(step @p9 (= @t10 @t8) :rule nary_cong :premises (@p8 @p7) :args (@t10))
(step @p10 @t11 :rule trans :premises (@p9 @p6))
(step @p11 @t11 :rule evaluate :args (@t10))
(step @p12 (= -1 @t10) :rule symm :premises (@p11))
(step @p13 @t12 :rule evaluate :args (@t1))
(step @p14 (= @t1 @t10) :rule trans :premises (@p13 @p12))
(step @p15 @t12 :rule trans :premises (@p14 @p10))
(step @p16 (= @t2 @t7) :rule cong :premises (@p15) :args (@t2))
(step @p17 @t3 :rule trans :premises (@p16 @p5))
(step @p18 (= @t3 @t6) :rule cong :premises (@p17 @p4) :args (@t3))
(step @p19 (= @t3 true) :rule trans :premises (@p18 @p3))
(step @p20 (= @t4 @t5) :rule cong :premises (@p19) :args (@t4))
(step @p21 (= @t4 false) :rule trans :premises (@p20 @p2))
(step @p22 false :rule eq_resolve :premises (@p1 @p21))
)
(
(define @t1 () (- 0 1))
(define @t2 () (str.from_int @t1))
(define @t3 () (= @t2 ""))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= "" ""))
(define @t7 () (str.from_int -1))
(assume @p1 @t4)
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule evaluate :args (@t6))
(step @p4 @t6 :rule refl :args (""))
(step @p5 (= @t7 "") :rule evaluate :args (@t7))
(step @p6 (= @t1 -1) :rule evaluate :args (@t1))
(step @p7 (= @t2 @t7) :rule cong :premises (@p6) :args (@t2))
(step @p8 @t3 :rule trans :premises (@p7 @p5))
(step @p9 (= @t3 @t6) :rule cong :premises (@p8 @p4) :args (@t3))
(step @p10 (= @t3 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t4 @t5) :rule cong :premises (@p10) :args (@t4))
(step @p12 (= @t4 false) :rule trans :premises (@p11 @p2))
(step @p13 false :rule eq_resolve :premises (@p1 @p12))
)
