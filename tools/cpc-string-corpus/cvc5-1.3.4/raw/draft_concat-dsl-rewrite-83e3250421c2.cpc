(
(declare-const x String)
(define @t1 () (= (str.++ x "a") (str.++ x "b")))
(define @t2 () (str.len "b"))
(define @t3 () (str.len "a"))
(define @t4 () (= "a" "b"))
(assume @p1 @t1)
(step @p2 (= @t2 1) :rule evaluate :args (@t2))
(step @p3 (= 1 @t2) :rule symm :premises (@p2))
(step @p4 (= @t3 1) :rule evaluate :args (@t3))
(step @p5 (= @t3 @t2) :rule trans :premises (@p4 @p3))
(step @p6 (= @t4 false) :rule evaluate :args (@t4))
(step @p7 (= @t1 false) :rule str-concat-clash-rev :premises (@p6 @p5) :args ("a" (str.++ x) "b" (str.++ x)))
(step @p8 false :rule eq_resolve :premises (@p1 @p7))
)