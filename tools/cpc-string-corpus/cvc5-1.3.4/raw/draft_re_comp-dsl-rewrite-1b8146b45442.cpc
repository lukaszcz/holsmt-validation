(
(declare-const x String)
(define @t1 () (str.to_re "a"))
(define @t2 () (str.in_re x @t1))
(define @t3 () (str.in_re x (re.comp @t1)))
(define @t4 () (= x "a"))
(define @t5 () (not @t4))
(define @t6 () (not @t2))
(assume @p1 @t2)
(assume @p2 @t3)
(step @p3 (= @t2 @t4) :rule re-in-cstring :args (x "a"))
(step @p4 (= @t6 @t5) :rule cong :premises (@p3) :args (@t6))
(step @p5 (= @t3 @t6) :rule re-in-comp :args (x @t1))
(step @p6 (= @t3 @t5) :rule trans :premises (@p5 @p4))
(step @p7 @t5 :rule eq_resolve :premises (@p2 @p6))
(step @p8 @t4 :rule eq_resolve :premises (@p1 @p3))
(step @p9 false :rule contra :premises (@p8 @p7))
)