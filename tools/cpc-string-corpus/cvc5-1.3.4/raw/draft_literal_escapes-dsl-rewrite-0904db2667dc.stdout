unsat
(
(define @t1 () (= "\u{2ffff}" "\u{2ffff}"))
(define @t2 () (= "A\u{1f642}" "A\u{1f642}"))
(define @t3 () (= "\u{5c}" "\u{5c}"))
(define @t4 () (= """" """"))
(define @t5 () (= "\u{7}" "\u{7}"))
(define @t6 () (and @t5 @t4 @t3 @t2 @t1))
(define @t7 () (not @t6))
(define @t8 () (not true))
(define @t9 () (and true true true true true))
(assume @p1 @t7)
(step @p2 (= @t8 false) :rule evaluate :args (@t8))
(step @p3 (= @t9 true) :rule evaluate :args (@t9))
(step @p4 (= @t1 true) :rule evaluate :args (@t1))
(step @p5 (= @t2 true) :rule evaluate :args (@t2))
(step @p6 (= @t3 true) :rule evaluate :args (@t3))
(step @p7 (= @t4 true) :rule evaluate :args (@t4))
(step @p8 (= @t5 true) :rule evaluate :args (@t5))
(step @p9 (= @t6 @t9) :rule nary_cong :premises (@p8 @p7 @p6 @p5 @p4) :args (@t6))
(step @p10 (= @t6 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t7 @t8) :rule cong :premises (@p10) :args (@t7))
(step @p12 (= @t7 false) :rule trans :premises (@p11 @p2))
(step @p13 false :rule eq_resolve :premises (@p1 @p12))
)
