(
(define @t1 () (str.to_re "a"))
(define @t2 () (re.+ @t1))
(define @t3 () (str.in_re "aaa" @t2))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (re.++ @t1 (re.* @t1)))
(define @t7 () (str.in_re "aaa" @t6))
(define @t8 () (= @t7 true))
(assume @p1 @t4)
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 @t8 :rule str-in-re-eval :args (@t8))
(step @p4 (= @t2 @t6) :rule re-plus-elim :args (@t1))
(step @p5 (= "aaa" "aaa") :rule refl :args ("aaa"))
(step @p6 (= @t3 @t7) :rule cong :premises (@p5 @p4) :args (@t3))
(step @p7 (= @t3 true) :rule trans :premises (@p6 @p3))
(step @p8 (= @t4 @t5) :rule cong :premises (@p7) :args (@t4))
(step @p9 (= @t4 false) :rule trans :premises (@p8 @p2))
(step @p10 false :rule eq_resolve :premises (@p1 @p9))
)