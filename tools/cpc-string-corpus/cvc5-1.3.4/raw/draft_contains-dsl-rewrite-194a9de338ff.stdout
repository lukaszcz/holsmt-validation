unsat
(
(declare-const x String)
(define @t1 () (str.contains (str.++ x "a") "a"))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (str.contains "a" "a"))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t1 true) :rule str-contains-concat-find :premises (@p3) :args ((str.++ x) "a" "a" ""))
(step @p5 (= @t2 @t3) :rule cong :premises (@p4) :args (@t2))
(step @p6 (= @t2 false) :rule trans :premises (@p5 @p2))
(step @p7 false :rule eq_resolve :premises (@p1 @p6))
)
(
(declare-const x String)
(define @t1 () (str.contains (str.++ x "a") "a"))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (str.contains "a" "a"))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t1 true) :rule str-contains-concat-find :premises (@p3) :args ((str.++ x) "a" "a" ""))
(step @p5 (= @t2 @t3) :rule cong :premises (@p4) :args (@t2))
(step @p6 (= @t2 false) :rule trans :premises (@p5 @p2))
(step @p7 false :rule eq_resolve :premises (@p1 @p6))
)
