(step @p7 (= "aaa" @t11) :rule symm :premises (@p6))
(step @p8 (= @t15 "aaa") :rule evaluate :args (@t15))
(step @p9 (= @t15 @t11) :rule trans :premises (@p8 @p7))
(step @p10 (= @t16 @t13) :rule cong :premises (@p9) :args (@t16))
(step @p11 (= @t18 @t16) :rule re-concat-merge :args (@t19 @t14 "a" @t19))
(step @p12 (= @t20 @t18) :rule re-concat-merge :args (@t19 "a" "a" (re.++ @t1)))
(step @p13 (= @t20 @t16) :rule trans :premises (@p12 @p11))
(step @p14 (= @t20 @t13) :rule trans :premises (@p13 @p10))
(step @p15 (= @t20 @t6) :rule trans :premises (@p14 @p5))
(step @p16 (= @t14 "aa") :rule evaluate :args (@t14))
(step @p17 (= @t17 @t7) :rule cong :premises (@p16) :args (@t17))
(step @p18 (= @t21 @t17) :rule re-concat-merge :args (@t19 "a" "a" @t19))
(step @p19 (= @t21 @t7) :rule trans :premises (@p18 @p17))
(step @p20 (= @t1 @t1) :rule refl :args (@t1))
(step @p21 (= @t22 @t8) :rule nary_cong :premises (@p20 @p19 @p15) :args (@t22))
(step @p22 @t23 :rule re-loop-elim :args (@t23))
(step @p23 (= @t2 @t8) :rule trans :premises (@p22 @p21))
(step @p24 (= "aa" "aa") :rule refl :args ("aa"))
(step @p25 (= @t3 @t9) :rule cong :premises (@p24 @p23) :args (@t3))
(step @p26 (= @t3 true) :rule trans :premises (@p25 @p3))
(step @p27 (= @t4 @t5) :rule cong :premises (@p26) :args (@t4))
(step @p28 (= @t4 false) :rule trans :premises (@p27 @p2))
(step @p29 false :rule eq_resolve :premises (@p1 @p28))
)
