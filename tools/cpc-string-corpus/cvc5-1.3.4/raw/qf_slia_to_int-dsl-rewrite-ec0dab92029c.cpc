(
(declare-const z Int)
(declare-const x String)
(define @t1 () (str.to_int x))
(define @t2 () (= (str.substr "" z @t1) ""))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (= "" ""))
(define @t6 () (str.len ""))
(assume @p1 @t3)
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 true) :rule evaluate :args (@t5))
(step @p4 @t5 :rule refl :args (""))
(step @p5 (= @t6 0) :rule evaluate :args (@t6))
(step @p6 @t2 :rule str-substr-empty-str :premises (@p5) :args ("" z @t1))
(step @p7 (= @t2 @t5) :rule cong :premises (@p6 @p4) :args (@t2))
(step @p8 (= @t2 true) :rule trans :premises (@p7 @p3))
(step @p9 (= @t3 @t4) :rule cong :premises (@p8) :args (@t3))
(step @p10 (= @t3 false) :rule trans :premises (@p9 @p2))
(step @p11 false :rule eq_resolve :premises (@p1 @p10))
)