unsat
(
(define @t1 () (str.< "a" "b"))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (and true true))
(define @t5 () (str.<= "a" "b"))
(define @t6 () (not false))
(define @t7 () (= "a" "b"))
(define @t8 () (not @t7))
(define @t9 () (and @t8 @t5))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t5 true) :rule evaluate :args (@t5))
(step @p5 (= @t6 true) :rule evaluate :args (@t6))
(step @p6 (= @t7 false) :rule evaluate :args (@t7))
(step @p7 (= @t8 @t6) :rule cong :premises (@p6) :args (@t8))
(step @p8 (= @t8 true) :rule trans :premises (@p7 @p5))
(step @p9 (= @t9 @t4) :rule nary_cong :premises (@p8 @p4) :args (@t9))
(step @p10 (= @t9 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t1 @t9) :rule str-lt-elim :args ("a" "b"))
(step @p12 (= @t1 true) :rule trans :premises (@p11 @p10))
(step @p13 (= @t2 @t3) :rule cong :premises (@p12) :args (@t2))
(step @p14 (= @t2 false) :rule trans :premises (@p13 @p2))
(step @p15 false :rule eq_resolve :premises (@p1 @p14))
)
(
(define @t1 () (str.< "a" "b"))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (and true true))
(define @t5 () (str.<= "a" "b"))
(define @t6 () (not false))
(define @t7 () (= "a" "b"))
(define @t8 () (not @t7))
(define @t9 () (and @t8 @t5))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t5 true) :rule evaluate :args (@t5))
(step @p5 (= @t6 true) :rule evaluate :args (@t6))
(step @p6 (= @t7 false) :rule evaluate :args (@t7))
(step @p7 (= @t8 @t6) :rule cong :premises (@p6) :args (@t8))
(step @p8 (= @t8 true) :rule trans :premises (@p7 @p5))
(step @p9 (= @t9 @t4) :rule nary_cong :premises (@p8 @p4) :args (@t9))
(step @p10 (= @t9 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t1 @t9) :rule str-lt-elim :args ("a" "b"))
(step @p12 (= @t1 true) :rule trans :premises (@p11 @p10))
(step @p13 (= @t2 @t3) :rule cong :premises (@p12) :args (@t2))
(step @p14 (= @t2 false) :rule trans :premises (@p13 @p2))
(step @p15 false :rule eq_resolve :premises (@p1 @p14))
)
