(
(define @t1 () (str.to_re "a"))
(define @t2 () (re.^ 2 @t1))
(define @t3 () (str.in_re "aa" @t2))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (str.to_re "aa"))
(define @t7 () (str.in_re "aa" @t6))
(define @t8 () (= @t7 true))
(define @t9 () (str.++ "a" "a"))
(define @t10 () (str.to_re @t9))
(define @t11 () (re.++ @t1 @t1))
(define @t12 () (str.to_re ""))
(define @t13 () (re.loop 2 2 @t1))
(define @t14 () (= @t13 @t11))
(define @t15 () (re.loop 2 2 @t1))
(define @t16 () (re.^ 2 @t1))
(define @t17 () (= @t16 @t15))
(define @t18 () (= @t2 @t13))
(assume @p1 @t4)
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 @t8 :rule str-in-re-eval :args (@t8))
(step @p4 (= @t9 "aa") :rule evaluate :args (@t9))
(step @p5 (= @t10 @t6) :rule cong :premises (@p4) :args (@t10))
(step @p6 (= @t11 @t10) :rule re-concat-merge :args (@t12 "a" "a" @t12))
(step @p7 (= @t11 @t6) :rule trans :premises (@p6 @p5))
(step @p8 @t14 :rule re-loop-elim :args (@t14))
(step @p9 (= @t13 @t6) :rule trans :premises (@p8 @p7))
(step @p10 (= @t13 @t15) :rule refl :args (@t13))
(step @p11 (= @t2 @t16) :rule refl :args (@t2))
(step @p12 (= @t18 @t17) :rule cong :premises (@p11 @p10) :args (@t18))
(step @p13 (= @t17 @t18) :rule symm :premises (@p12))
(step @p14 @t17 :rule re-repeat-elim :args (2 @t1))
(step @p15 @t18 :rule eq_resolve :premises (@p14 @p13))
(step @p16 (= @t2 @t6) :rule trans :premises (@p15 @p9))
(step @p17 (= "aa" "aa") :rule refl :args ("aa"))
(step @p18 (= @t3 @t7) :rule cong :premises (@p17 @p16) :args (@t3))
(step @p19 (= @t3 true) :rule trans :premises (@p18 @p3))
(step @p20 (= @t4 @t5) :rule cong :premises (@p19) :args (@t4))
(step @p21 (= @t4 false) :rule trans :premises (@p20 @p2))
(step @p22 false :rule eq_resolve :premises (@p1 @p21))
)