(
(define @t1 () (re.++ (str.to_re "a") (str.to_re "b")))
(define @t2 () (str.in_re "ab" @t1))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (str.to_re "ab"))
(define @t6 () (str.in_re "ab" @t5))
(define @t7 () (= @t6 true))
(define @t8 () (str.++ "a" "b"))
(define @t9 () (str.to_re @t8))
(define @t10 () (str.to_re ""))
(assume @p1 @t3)
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 @t7 :rule str-in-re-eval :args (@t7))
(step @p4 (= @t8 "ab") :rule evaluate :args (@t8))
(step @p5 (= @t9 @t5) :rule cong :premises (@p4) :args (@t9))
(step @p6 (= @t1 @t9) :rule re-concat-merge :args (@t10 "a" "b" @t10))
(step @p7 (= @t1 @t5) :rule trans :premises (@p6 @p5))
(step @p8 (= "ab" "ab") :rule refl :args ("ab"))
(step @p9 (= @t2 @t6) :rule cong :premises (@p8 @p7) :args (@t2))
(step @p10 (= @t2 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t3 @t4) :rule cong :premises (@p10) :args (@t3))
(step @p12 (= @t3 false) :rule trans :premises (@p11 @p2))
(step @p13 false :rule eq_resolve :premises (@p1 @p12))
)