(
(define @t1 () (str.at "abc" 1))
(define @t2 () (= @t1 "b"))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (= "b" "b"))
(define @t6 () (str.substr "abc" 1 1))
(define @t7 () (= @t6 "b"))
(assume @p1 @t3)
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 true) :rule evaluate :args (@t5))
(step @p4 @t5 :rule refl :args ("b"))
(step @p5 @t7 :rule evaluate :args (@t6))
(step @p6 @t7 :rule evaluate :args (@t6))
(step @p7 (= "b" @t6) :rule symm :premises (@p6))
(step @p8 @t2 :rule evaluate :args (@t1))
(step @p9 (= @t1 @t6) :rule trans :premises (@p8 @p7))
(step @p10 @t2 :rule trans :premises (@p9 @p5))
(step @p11 (= @t2 @t5) :rule cong :premises (@p10 @p4) :args (@t2))
(step @p12 (= @t2 true) :rule trans :premises (@p11 @p3))
(step @p13 (= @t3 @t4) :rule cong :premises (@p12) :args (@t3))
(step @p14 (= @t3 false) :rule trans :premises (@p13 @p2))
(step @p15 false :rule eq_resolve :premises (@p1 @p14))
)