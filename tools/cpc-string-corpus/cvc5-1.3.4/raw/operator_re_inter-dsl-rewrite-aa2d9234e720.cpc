(
(define @t1 () (str.to_re "a"))
(define @t2 () (re.inter re.allchar @t1))
(define @t3 () (str.in_re "a" @t2))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (str.in_re "a" @t1))
(define @t7 () (= @t6 true))
(define @t8 () (re.inter @t1 re.allchar @t1))
(define @t9 () (= (str.in_re "a" @t8) true))
(define @t10 () (= @t2 @t8))
(assume @p1 @t4)
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 @t7 :rule str-in-re-eval :args (@t7))
(step @p4 @t9 :rule str-in-re-eval :args (@t9))
(step @p5 (= @t8 @t1) :rule re-inter-cstring :premises (@p4) :args (re.allchar (re.inter @t1) "a"))
(step @p6 @t10 :rule aci_norm :args (@t10))
(step @p7 (= @t2 @t1) :rule trans :premises (@p6 @p5))
(step @p8 (= "a" "a") :rule refl :args ("a"))
(step @p9 (= @t3 @t6) :rule cong :premises (@p8 @p7) :args (@t3))
(step @p10 (= @t3 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t4 @t5) :rule cong :premises (@p10) :args (@t4))
(step @p12 (= @t4 false) :rule trans :premises (@p11 @p2))
(step @p13 false :rule eq_resolve :premises (@p1 @p12))
)