(
(define @t1 () (set.singleton 7))
(define @t2 () (set.complement @t1))
(define @t3 () (set.member 7 @t2))
(define @t4 () (not @t3))
(define @t5 () (not @t4))
(define @t6 () (set.member 7 (as set.universe (Set Int))))
(define @t7 () (and @t6 false))
(define @t8 () (= @t7 false))
(define @t9 () (not true))
(define @t10 () (= 7 7))
(define @t11 () (set.member 7 @t1))
(define @t12 () (not @t11))
(define @t13 () (and @t6 @t12))
(define @t14 () (set.minus (as set.universe (Set Int)) @t1))
(define @t15 () (set.member 7 @t14))
(assume @p1 (and @t4 @t5))
(step @p2 @t8 :rule absorb :args (@t8))
(step @p3 (= @t9 false) :rule evaluate :args (@t9))
(step @p4 (= @t10 true) :rule evaluate :args (@t10))
(step @p5 (= @t11 @t10) :rule sets-member-singleton :args (7 7))
(step @p6 (= @t11 true) :rule trans :premises (@p5 @p4))
(step @p7 (= @t12 @t9) :rule cong :premises (@p6) :args (@t12))
(step @p8 (= @t12 false) :rule trans :premises (@p7 @p3))
(step @p9 (= @t6 @t6) :rule refl :args (@t6))
(step @p10 (= @t13 @t7) :rule nary_cong :premises (@p9 @p8) :args (@t13))
(step @p11 (= @t13 false) :rule trans :premises (@p10 @p2))
(step @p12 (= @t15 @t13) :rule sets-minus-member :args (7 (as set.universe (Set Int)) @t1))
(step @p13 (= @t15 false) :rule trans :premises (@p12 @p11))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p14 (= @t2 @t14) :rule trust :premises () :args ((= @t2 @t14)))
(step @p15 @t10 :rule refl :args (7))
(step @p16 (= @t3 @t15) :rule cong :premises (@p15 @p14) :args (@t3))
(step @p17 (= @t3 false) :rule trans :premises (@p16 @p13))
(step @p18 (= @t5 @t3) :rule bool-double-not-elim :args (@t3))
(step @p19 (= @t5 false) :rule trans :premises (@p18 @p17))
(step @p20 @t5 :rule and_elim :premises (@p1) :args (1))
(step @p21 false :rule eq_resolve :premises (@p20 @p19))
)