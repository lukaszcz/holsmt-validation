(
(define @t1 () (seq.unit 2))
(define @t2 () (seq.unit 1))
(define @t3 () (seq.++ @t2 @t1))
(define @t4 () (seq.contains @t3 @t1))
(define @t5 () (not @t4))
(define @t6 () (not true))
(define @t7 () (= @t4 true))
(define @t8 () (= @t1 @t1))
(define @t9 () (= @t3 @t3))
(define @t10 () (= @t2 @t2))
(assume @p1 (and @t4 @t5))
(step @p2 (= @t6 false) :rule evaluate :args (@t6))
(step @p3 @t7 :rule seq-eval-op :args (@t7))
(step @p4 @t8 :rule seq-eval-op :args (@t8))
(step @p5 @t9 :rule seq-eval-op :args (@t9))
(step @p6 @t10 :rule seq-eval-op :args (@t10))
(step @p7 @t9 :rule nary_cong :premises (@p6 @p4) :args (@t3))
(step @p8 @t9 :rule trans :premises (@p7 @p5))
(step @p9 (= @t4 @t4) :rule cong :premises (@p8 @p4) :args (@t4))
(step @p10 @t7 :rule trans :premises (@p9 @p3))
(step @p11 (= @t5 @t6) :rule cong :premises (@p10) :args (@t5))
(step @p12 (= @t5 false) :rule trans :premises (@p11 @p2))
(step @p13 @t5 :rule and_elim :premises (@p1) :args (1))
(step @p14 false :rule eq_resolve :premises (@p13 @p12))
)