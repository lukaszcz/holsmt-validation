(
(declare-const cb (Bag Int))
(declare-const hp (-> Int Bool))
(declare-const cc (Bag Int))
(define @t1 () (bag.all hp cc))
(define @t2 () (bag.all hp cb))
(define @t3 () (= @t2 @t1))
(define @t4 () (not @t3))
(define @t5 () (bag.filter hp cc))
(define @t6 () (= cc @t5))
(define @t7 () (= @t5 cc))
(define @t8 () (bag.filter hp cb))
(define @t9 () (= cb @t8))
(define @t10 () (= @t8 cb))
(define @t11 () (= @t9 @t6))
(define @t12 () (not @t11))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t7 @t6) :rule eq-symm :args (@t5 cc))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p3 (= @t1 @t7) :rule trust :premises () :args ((= @t1 @t7)))
(step @p4 (= @t1 @t6) :rule trans :premises (@p3 @p2))
(step @p5 (= @t10 @t9) :rule eq-symm :args (@t8 cb))
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t2 @t10) :rule trust :premises () :args ((= @t2 @t10)))
(step @p7 (= @t2 @t9) :rule trans :premises (@p6 @p5))
(step @p8 (= @t3 @t11) :rule cong :premises (@p7 @p4) :args (@t3))
(step @p9 (= @t4 @t12) :rule cong :premises (@p8) :args (@t4))
(step @p10 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p11 @t12 :rule eq_resolve :premises (@p10 @p9))
(step @p12 @t3 :rule and_elim :premises (@p1) :args (0))
(step @p13 @t11 :rule eq_resolve :premises (@p12 @p8))
(step @p14 false :rule contra :premises (@p13 @p11))
)