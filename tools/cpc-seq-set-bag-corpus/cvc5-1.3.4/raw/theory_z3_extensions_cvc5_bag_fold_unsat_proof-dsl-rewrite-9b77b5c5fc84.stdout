unsat
(
(define @t1 () (@var "a" Int))
(define @t2 () (@var "x" Int))
(define @t3 () (lambda (@list @t2 @t1) (+ @t2 @t1)))
(define @t4 () (bag.fold @t3 0 (bag 7 2)))
(define @t5 () (= @t4 14))
(define @t6 () (not @t5))
(define @t7 () (not true))
(define @t8 () (= 14 14))
(define @t9 () (+ 7 7))
(define @t10 () (_ @t3 7 7))
(define @t11 () (= @t10 @t9))
(define @t12 () (+ 7 0))
(define @t13 () (_ @t3 7 0))
(define @t14 () (= @t13 @t12))
(define @t15 () (_ @t3 7 @t13))
(assume @p1 (and @t5 @t6))
(step @p2 (= @t7 false) :rule evaluate :args (@t7))
(step @p3 (= @t8 true) :rule evaluate :args (@t8))
(step @p4 @t8 :rule refl :args (14))
(step @p5 (= @t9 14) :rule evaluate :args (@t9))
(step @p6 @t11 :rule beta-reduce :args (@t11))
(step @p7 (= @t10 14) :rule trans :premises (@p6 @p5))
(step @p8 (= @t12 7) :rule evaluate :args (@t12))
(step @p9 @t14 :rule beta-reduce :args (@t14))
(step @p10 (= @t13 7) :rule trans :premises (@p9 @p8))
(step @p11 (= 7 7) :rule refl :args (7))
(step @p12 (= @t15 @t10) :rule cong :premises (@p11 @p10) :args (@t15))
(step @p13 (= @t15 14) :rule trans :premises (@p12 @p7))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p14 (= @t4 @t15) :rule trust :premises () :args ((= @t4 @t15)))
(step @p15 @t5 :rule trans :premises (@p14 @p13))
(step @p16 (= @t5 @t8) :rule cong :premises (@p15 @p4) :args (@t5))
(step @p17 (= @t5 true) :rule trans :premises (@p16 @p3))
(step @p18 (= @t6 @t7) :rule cong :premises (@p17) :args (@t6))
(step @p19 (= @t6 false) :rule trans :premises (@p18 @p2))
(step @p20 @t6 :rule and_elim :premises (@p1) :args (1))
(step @p21 false :rule eq_resolve :premises (@p20 @p19))
)
(
