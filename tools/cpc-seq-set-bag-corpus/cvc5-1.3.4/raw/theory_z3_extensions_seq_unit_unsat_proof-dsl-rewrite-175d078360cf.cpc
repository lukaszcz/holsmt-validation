(
(define @t1 () (seq.unit 7))
(define @t2 () (seq.len @t1))
(define @t3 () (= @t2 1))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= 1 1))
(define @t7 () (= @t1 @t1))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule evaluate :args (@t6))
(step @p4 @t6 :rule refl :args (1))
(step @p5 @t3 :rule seq-eval-op :args (@t3))
(step @p6 @t7 :rule seq-eval-op :args (@t7))
(step @p7 (= @t2 @t2) :rule cong :premises (@p6) :args (@t2))
(step @p8 @t3 :rule trans :premises (@p7 @p5))
(step @p9 (= @t3 @t6) :rule cong :premises (@p8 @p4) :args (@t3))
(step @p10 (= @t3 true) :rule trans :premises (@p9 @p3))
(step @p11 (= @t4 @t5) :rule cong :premises (@p10) :args (@t4))
(step @p12 (= @t4 false) :rule trans :premises (@p11 @p2))
(step @p13 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p14 false :rule eq_resolve :premises (@p13 @p12))
)