(set-option :produce-proofs true)
(set-logic HO_ALL)
(declare-const cb (Bag Int))
(declare-const cc (Bag Int))
(declare-const hf1 (-> Int Int))
(declare-const hp (-> Int Bool))
(declare-const hf2 (-> Int Int Int))
