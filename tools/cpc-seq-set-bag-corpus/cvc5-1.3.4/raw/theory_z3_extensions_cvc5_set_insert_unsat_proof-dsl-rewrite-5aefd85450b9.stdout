unsat
(
(declare-const cs (Set Int))
(define @t1 () (set.insert (@list 7) cs))
(define @t2 () (set.member 7 @t1))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (set.member 7 cs))
(define @t6 () (or @t5 true))
(define @t7 () (= @t6 true))
(define @t8 () (= 7 7))
(define @t9 () (set.singleton 7))
(define @t10 () (set.member 7 @t9))
(define @t11 () (or @t5 @t10))
(define @t12 () (set.union cs @t9))
(define @t13 () (set.member 7 @t12))
(define @t14 () (set.union @t9 cs))
(define @t15 () (= @t1 @t14))
(assume @p1 (and @t2 @t3))
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 @t7 :rule absorb :args (@t7))
(step @p4 (= @t8 true) :rule evaluate :args (@t8))
(step @p5 (= @t10 @t8) :rule sets-member-singleton :args (7 7))
(step @p6 (= @t10 true) :rule trans :premises (@p5 @p4))
(step @p7 (= @t5 @t5) :rule refl :args (@t5))
(step @p8 (= @t11 @t6) :rule nary_cong :premises (@p7 @p6) :args (@t11))
(step @p9 (= @t11 true) :rule trans :premises (@p8 @p3))
(step @p10 (= @t13 @t11) :rule sets-union-member :args (7 cs @t9))
(step @p11 (= @t13 true) :rule trans :premises (@p10 @p9))
(step @p12 (= @t14 @t12) :rule sets-union-comm :args (@t9 cs))
(step @p13 @t15 :rule sets-insert-elim :args (@t15))
(step @p14 (= @t1 @t12) :rule trans :premises (@p13 @p12))
(step @p15 @t8 :rule refl :args (7))
(step @p16 (= @t2 @t13) :rule cong :premises (@p15 @p14) :args (@t2))
(step @p17 (= @t2 true) :rule trans :premises (@p16 @p11))
(step @p18 (= @t3 @t4) :rule cong :premises (@p17) :args (@t3))
(step @p19 (= @t3 false) :rule trans :premises (@p18 @p2))
(step @p20 @t3 :rule and_elim :premises (@p1) :args (1))
(step @p21 false :rule eq_resolve :premises (@p20 @p19))
)
(
