unsat
(
(define @t1 () (seq.unit 7))
(define @t2 () (seq.at @t1 0))
(define @t3 () (= @t2 @t1))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= @t1 @t1))
(define @t7 () (seq.extract @t1 0 1))
(define @t8 () (= @t7 @t1))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule eq-refl :args (@t1))
(step @p4 @t6 :rule seq-eval-op :args (@t6))
(step @p5 @t8 :rule seq-eval-op :args (@t8))
(step @p6 (= @t2 @t7) :rule str-at-elim :args (@t1 0))
(step @p7 @t3 :rule trans :premises (@p6 @p5))
(step @p8 (= 0 0) :rule refl :args (0))
(step @p9 (= @t2 @t2) :rule cong :premises (@p4 @p8) :args (@t2))
(step @p10 @t3 :rule trans :premises (@p9 @p7))
(step @p11 (= @t3 @t6) :rule cong :premises (@p10 @p4) :args (@t3))
(step @p12 (= @t3 true) :rule trans :premises (@p11 @p3))
(step @p13 (= @t4 @t5) :rule cong :premises (@p12) :args (@t4))
(step @p14 (= @t4 false) :rule trans :premises (@p13 @p2))
(step @p15 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p16 false :rule eq_resolve :premises (@p15 @p14))
)
(
