(
(define @t1 () (seq.unit 2))
(define @t2 () (seq.unit 1))
(define @t3 () (seq.update @t2 0 @t1))
(define @t4 () (= @t3 @t1))
(define @t5 () (not @t4))
(define @t6 () (not true))
(define @t7 () (= @t1 @t1))
(define @t8 () (= @t2 @t2))
(assume @p1 (and @t4 @t5))
(step @p2 (= @t6 false) :rule evaluate :args (@t6))
(step @p3 (= @t7 true) :rule eq-refl :args (@t1))
(step @p4 @t7 :rule seq-eval-op :args (@t7))
(step @p5 @t4 :rule seq-eval-op :args (@t4))
(step @p6 (= 0 0) :rule refl :args (0))
(step @p7 @t8 :rule seq-eval-op :args (@t8))
(step @p8 (= @t3 @t3) :rule cong :premises (@p7 @p6 @p4) :args (@t3))
(step @p9 @t4 :rule trans :premises (@p8 @p5))
(step @p10 (= @t4 @t7) :rule cong :premises (@p9 @p4) :args (@t4))
(step @p11 (= @t4 true) :rule trans :premises (@p10 @p3))
(step @p12 (= @t5 @t6) :rule cong :premises (@p11) :args (@t5))
(step @p13 (= @t5 false) :rule trans :premises (@p12 @p2))
(step @p14 @t5 :rule and_elim :premises (@p1) :args (1))
(step @p15 false :rule eq_resolve :premises (@p14 @p13))
)