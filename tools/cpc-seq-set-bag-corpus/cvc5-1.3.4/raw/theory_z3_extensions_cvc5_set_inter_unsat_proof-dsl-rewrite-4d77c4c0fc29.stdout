(step @p10 (= @t4 @t5) :rule cong :premises (@p9) :args (@t4))
(step @p11 (= @t4 false) :rule trans :premises (@p10 @p2))
(step @p12 @t4 :rule and_elim :premises (@p1) :args (1))
