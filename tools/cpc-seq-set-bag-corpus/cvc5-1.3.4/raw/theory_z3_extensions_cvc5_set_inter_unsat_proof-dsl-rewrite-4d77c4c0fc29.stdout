unsat
(
(define @t1 () (set.singleton 7))
(define @t2 () (set.inter @t1 @t1))
(define @t3 () (set.member 7 @t2))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= 7 7))
(define @t7 () (set.member 7 @t1))
(define @t8 () (= @t2 @t1))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule evaluate :args (@t6))
(step @p4 (= @t7 @t6) :rule sets-member-singleton :args (7 7))
(step @p5 (= @t7 true) :rule trans :premises (@p4 @p3))
(step @p6 @t8 :rule sets-eval-op :args (@t8))
(step @p7 @t6 :rule refl :args (7))
(step @p8 (= @t3 @t7) :rule cong :premises (@p7 @p6) :args (@t3))
(step @p9 (= @t3 true) :rule trans :premises (@p8 @p5))
(step @p10 (= @t4 @t5) :rule cong :premises (@p9) :args (@t4))
(step @p11 (= @t4 false) :rule trans :premises (@p10 @p2))
(step @p12 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p13 false :rule eq_resolve :premises (@p12 @p11))
)
(
