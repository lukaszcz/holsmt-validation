(
(define @t1 () (bag 7 2))
(define @t2 () (@var "y" Int))
(define @t3 () (@var "x" Int))
(define @t4 () (bag.partition (lambda (@list @t3 @t2) (= @t3 @t2)) @t1))
(define @t5 () (bag.member @t1 @t4))
(define @t6 () (not @t5))
(define @t7 () (not true))
(define @t8 () (>= 1 1))
(define @t9 () (bag @t1 1))
(define @t10 () (bag.count @t1 @t9))
(define @t11 () (bag.count @t1 @t4))
(define @t12 () (>= @t11 1))
(assume @p1 (and @t5 @t6))
(step @p2 (= @t7 false) :rule evaluate :args (@t7))
(step @p3 (= @t8 true) :rule evaluate :args (@t8))
(step @p4 (= 1 1) :rule refl :args (1))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p5 (= @t10 1) :rule trust :premises () :args ((= @t10 1)))
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t4 @t9) :rule trust :premises () :args ((= @t4 @t9)))
(step @p7 (= @t1 @t1) :rule refl :args (@t1))
(step @p8 (= @t11 @t10) :rule cong :premises (@p7 @p6) :args (@t11))
(step @p9 (= @t11 1) :rule trans :premises (@p8 @p5))
(step @p10 (= @t12 @t8) :rule cong :premises (@p9 @p4) :args (@t12))
(step @p11 (= @t12 true) :rule trans :premises (@p10 @p3))
; trust TRUST_THEORY_REWRITE
(step @p12 (= @t5 @t12) :rule trust :premises () :args ((= @t5 @t12)))
(step @p13 (= @t5 true) :rule trans :premises (@p12 @p11))
(step @p14 (= @t6 @t7) :rule cong :premises (@p13) :args (@t6))
(step @p15 (= @t6 false) :rule trans :premises (@p14 @p2))
(step @p16 @t6 :rule and_elim :premises (@p1) :args (1))
(step @p17 false :rule eq_resolve :premises (@p16 @p15))
)