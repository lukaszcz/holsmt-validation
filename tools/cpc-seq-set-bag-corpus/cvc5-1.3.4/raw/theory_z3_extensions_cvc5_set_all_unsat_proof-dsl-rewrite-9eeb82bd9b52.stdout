unsat
(
(define @t1 () (set.singleton 7))
(define @t2 () (@var "x" Int))
(define @t3 () (lambda (@list @t2) true))
(define @t4 () (set.all @t3 @t1))
(define @t5 () (not @t4))
(define @t6 () (not true))
(define @t7 () (@var "BOUND_VARIABLE_7429" Int))
(define @t8 () (lambda (@list @t7) true))
(define @t9 () (_ @t8 7))
(define @t10 () (set.all @t8 @t1))
(define @t11 () (= @t8 @t8))
(define @t12 () (= @t3 @t8))
(assume @p1 (and @t4 @t5))
(step @p2 (= @t6 false) :rule evaluate :args (@t6))
; WARNING: add trust step for EVALUATE
; trust EVALUATE
(step @p3 (= @t9 true) :rule trust :premises () :args ((= @t9 true)))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p4 (= @t10 @t9) :rule trust :premises () :args ((= @t10 @t9)))
(step @p5 (= @t10 true) :rule trans :premises (@p4 @p3))
(step @p6 (= @t1 @t1) :rule refl :args (@t1))
(step @p7 @t11 :rule refl :args (@t8))
(step @p8 @t11 :rule symm :premises (@p7))
(step @p9 @t12 :rule alpha_equiv :args (@t3 (@list @t2) (@list @t7)))
(step @p10 @t12 :rule trans :premises (@p9 @p8))
(step @p11 (= @t4 @t10) :rule cong :premises (@p10 @p6) :args (@t4))
(step @p12 (= @t4 true) :rule trans :premises (@p11 @p5))
(step @p13 (= @t5 @t6) :rule cong :premises (@p12) :args (@t5))
(step @p14 (= @t5 false) :rule trans :premises (@p13 @p2))
(step @p15 @t5 :rule and_elim :premises (@p1) :args (1))
(step @p16 false :rule eq_resolve :premises (@p15 @p14))
)
