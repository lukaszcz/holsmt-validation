(
(define @t1 () (= (set.choose (set.singleton 7)) 7))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (= 7 7))
(assume @p1 (and @t1 @t2))
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 @t4 :rule refl :args (7))
(step @p5 @t1 :rule sets-choose-singleton :args (7))
(step @p6 (= @t1 @t4) :rule cong :premises (@p5 @p4) :args (@t1))
(step @p7 (= @t1 true) :rule trans :premises (@p6 @p3))
(step @p8 (= @t2 @t3) :rule cong :premises (@p7) :args (@t2))
(step @p9 (= @t2 false) :rule trans :premises (@p8 @p2))
(step @p10 @t2 :rule and_elim :premises (@p1) :args (1))
(step @p11 false :rule eq_resolve :premises (@p10 @p9))
)