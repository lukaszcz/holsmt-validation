(
(define @t1 () (set.singleton 7))
(define @t2 () (set.minus @t1 @t1))
(define @t3 () (set.member 7 @t2))
(define @t4 () (not @t3))
(define @t5 () (not @t4))
(define @t6 () (set.member 7 (as set.empty (Set Int))))
(assume @p1 (and @t4 @t5))
(step @p2 (= (as set.empty (Set Int)) (as set.empty (Set Int))) :rule refl :args ((as set.empty (Set Int))))
(step @p3 (= @t6 false) :rule sets-member-emp :premises (@p2) :args (7 (as set.empty (Set Int)) (Set Int)))
(step @p4 (= @t2 (as set.empty (Set Int))) :rule sets-minus-self :args (@t1 (Set Int)))
(step @p5 (= 7 7) :rule refl :args (7))
(step @p6 (= @t3 @t6) :rule cong :premises (@p5 @p4) :args (@t3))
(step @p7 (= @t3 false) :rule trans :premises (@p6 @p3))
(step @p8 (= @t5 @t3) :rule bool-double-not-elim :args (@t3))
(step @p9 (= @t5 false) :rule trans :premises (@p8 @p7))
(step @p10 @t5 :rule and_elim :premises (@p1) :args (1))
(step @p11 false :rule eq_resolve :premises (@p10 @p9))
)