(
(declare-const ct (Set Int))
(define @t1 () (set.singleton 7))
(define @t2 () (set.union @t1 ct))
(define @t3 () (set.member 7 @t2))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (set.member 7 ct))
(define @t7 () (or @t6 true))
(define @t8 () (= @t7 true))
(define @t9 () (= 7 7))
(define @t10 () (set.member 7 @t1))
(define @t11 () (or @t6 @t10))
(define @t12 () (set.union ct @t1))
(define @t13 () (set.member 7 @t12))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 @t8 :rule absorb :args (@t8))
(step @p4 (= @t9 true) :rule evaluate :args (@t9))
(step @p5 (= @t10 @t9) :rule sets-member-singleton :args (7 7))
(step @p6 (= @t10 true) :rule trans :premises (@p5 @p4))
(step @p7 (= @t6 @t6) :rule refl :args (@t6))
(step @p8 (= @t11 @t7) :rule nary_cong :premises (@p7 @p6) :args (@t11))
(step @p9 (= @t11 true) :rule trans :premises (@p8 @p3))
(step @p10 (= @t13 @t11) :rule sets-union-member :args (7 ct @t1))
(step @p11 (= @t13 true) :rule trans :premises (@p10 @p9))
(step @p12 (= @t2 @t12) :rule sets-union-comm :args (@t1 ct))
(step @p13 @t9 :rule refl :args (7))
(step @p14 (= @t3 @t13) :rule cong :premises (@p13 @p12) :args (@t3))
(step @p15 (= @t3 true) :rule trans :premises (@p14 @p11))
(step @p16 (= @t4 @t5) :rule cong :premises (@p15) :args (@t4))
(step @p17 (= @t4 false) :rule trans :premises (@p16 @p2))
(step @p18 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p19 false :rule eq_resolve :premises (@p18 @p17))
)