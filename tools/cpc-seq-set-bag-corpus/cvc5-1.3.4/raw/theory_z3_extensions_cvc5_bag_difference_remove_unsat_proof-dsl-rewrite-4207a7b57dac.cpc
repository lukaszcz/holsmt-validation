(
(define @t1 () (bag.difference_remove (bag 7 3) (bag 7 2)))
(define @t2 () (bag.count 7 @t1))
(define @t3 () (= @t2 0))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= 0 0))
(define @t7 () (bag.count 7 (as bag.empty (Bag Int))))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule evaluate :args (@t6))
(step @p4 @t6 :rule refl :args (0))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p5 (= @t7 0) :rule trust :premises () :args ((= @t7 0)))
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t1 (as bag.empty (Bag Int))) :rule trust :premises () :args ((= @t1 (as bag.empty (Bag Int)))))
(step @p7 (= 7 7) :rule refl :args (7))
(step @p8 (= @t2 @t7) :rule cong :premises (@p7 @p6) :args (@t2))
(step @p9 @t3 :rule trans :premises (@p8 @p5))
(step @p10 (= @t3 @t6) :rule cong :premises (@p9 @p4) :args (@t3))
(step @p11 (= @t3 true) :rule trans :premises (@p10 @p3))
(step @p12 (= @t4 @t5) :rule cong :premises (@p11) :args (@t4))
(step @p13 (= @t4 false) :rule trans :premises (@p12 @p2))
(step @p14 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p15 false :rule eq_resolve :premises (@p14 @p13))
)