unsat
(
(define @t1 () (@var "x" Int))
(define @t2 () (set.member 7 (set.comprehension (@list @t1) (= @t1 7) @t1)))
(define @t3 () (not @t2))
(assume @p1 (and @t2 @t3))
(step @p2 @t3 :rule and_elim :premises (@p1) :args (1))
(step @p3 @t2 :rule and_elim :premises (@p1) :args (0))
(step @p4 false :rule contra :premises (@p3 @p2))
)
(
(define @t1 () (@var "x" Int))
(define @t2 () (set.member 7 (set.comprehension (@list @t1) (= @t1 7) @t1)))
(define @t3 () (not @t2))
(assume @p1 (and @t2 @t3))
(step @p2 @t3 :rule and_elim :premises (@p1) :args (1))
(step @p3 @t2 :rule and_elim :premises (@p1) :args (0))
(step @p4 false :rule contra :premises (@p3 @p2))
)
