(
(define @t1 () (seq.unit 2))
(define @t2 () (seq.unit 1))
(define @t3 () (seq.++ @t2 @t1))
(define @t4 () (seq.len @t3))
(define @t5 () (= @t4 2))
(define @t6 () (not @t5))
(define @t7 () (not true))
(define @t8 () (= 2 2))
(define @t9 () (= @t3 @t3))
(define @t10 () (= @t1 @t1))
(define @t11 () (= @t2 @t2))
(assume @p1 (and @t5 @t6))
(step @p2 (= @t7 false) :rule evaluate :args (@t7))
(step @p3 (= @t8 true) :rule evaluate :args (@t8))
(step @p4 @t8 :rule refl :args (2))
(step @p5 @t5 :rule seq-eval-op :args (@t5))
(step @p6 @t9 :rule seq-eval-op :args (@t9))
(step @p7 @t10 :rule seq-eval-op :args (@t10))
(step @p8 @t11 :rule seq-eval-op :args (@t11))
(step @p9 @t9 :rule nary_cong :premises (@p8 @p7) :args (@t3))
(step @p10 @t9 :rule trans :premises (@p9 @p6))
(step @p11 (= @t4 @t4) :rule cong :premises (@p10) :args (@t4))
(step @p12 @t5 :rule trans :premises (@p11 @p5))
(step @p13 (= @t5 @t8) :rule cong :premises (@p12 @p4) :args (@t5))
(step @p14 (= @t5 true) :rule trans :premises (@p13 @p3))
(step @p15 (= @t6 @t7) :rule cong :premises (@p14) :args (@t6))
(step @p16 (= @t6 false) :rule trans :premises (@p15 @p2))
(step @p17 @t6 :rule and_elim :premises (@p1) :args (1))
(step @p18 false :rule eq_resolve :premises (@p17 @p16))
)