unsat
(
(declare-const cs (Set Int))
(define @t1 () (set.insert (@list 7) cs))
(define @t2 () (set.singleton 7))
(define @t3 () (set.subset @t2 @t1))
(define @t4 () (not @t3))
(define @t5 () (set.union cs @t2))
(define @t6 () (set.union @t2 @t5))
(define @t7 () (= @t5 @t6))
(define @t8 () (= @t6 @t5))
(define @t9 () (set.union @t2 cs))
(define @t10 () (= @t1 @t9))
(define @t11 () (set.union @t2 @t1))
(define @t12 () (= @t11 @t1))
(define @t13 () (not @t7))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t8 @t7) :rule eq-symm :args (@t6 @t5))
(step @p3 (= @t9 @t5) :rule sets-union-comm :args (@t2 cs))
(step @p4 @t10 :rule sets-insert-elim :args (@t10))
(step @p5 (= @t1 @t5) :rule trans :premises (@p4 @p3))
(step @p6 (= @t2 @t2) :rule refl :args (@t2))
(step @p7 (= @t11 @t6) :rule cong :premises (@p6 @p5) :args (@t11))
(step @p8 (= @t12 @t8) :rule cong :premises (@p7 @p5) :args (@t12))
(step @p9 (= @t12 @t7) :rule trans :premises (@p8 @p2))
(step @p10 (= @t3 @t12) :rule sets-subset-elim :args (@t2 @t1))
(step @p11 (= @t3 @t7) :rule trans :premises (@p10 @p9))
(step @p12 (= @t4 @t13) :rule cong :premises (@p11) :args (@t4))
(step @p13 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p14 @t13 :rule eq_resolve :premises (@p13 @p12))
(step @p15 @t3 :rule and_elim :premises (@p1) :args (0))
(step @p16 @t7 :rule eq_resolve :premises (@p15 @p11))
(step @p17 false :rule contra :premises (@p16 @p14))
)
(
(declare-const cs (Set Int))
(define @t1 () (set.insert (@list 7) cs))
(define @t2 () (set.singleton 7))
(define @t3 () (set.subset @t2 @t1))
(define @t4 () (not @t3))
(define @t5 () (set.union cs @t2))
(define @t6 () (set.union @t2 @t5))
(define @t7 () (= @t5 @t6))
(define @t8 () (= @t6 @t5))
(define @t9 () (set.union @t2 cs))
(define @t10 () (= @t1 @t9))
(define @t11 () (set.union @t2 @t1))
(define @t12 () (= @t11 @t1))
(define @t13 () (not @t7))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t8 @t7) :rule eq-symm :args (@t6 @t5))
(step @p3 (= @t9 @t5) :rule sets-union-comm :args (@t2 cs))
(step @p4 @t10 :rule sets-insert-elim :args (@t10))
(step @p5 (= @t1 @t5) :rule trans :premises (@p4 @p3))
(step @p6 (= @t2 @t2) :rule refl :args (@t2))
(step @p7 (= @t11 @t6) :rule cong :premises (@p6 @p5) :args (@t11))
(step @p8 (= @t12 @t8) :rule cong :premises (@p7 @p5) :args (@t12))
(step @p9 (= @t12 @t7) :rule trans :premises (@p8 @p2))
(step @p10 (= @t3 @t12) :rule sets-subset-elim :args (@t2 @t1))
(step @p11 (= @t3 @t7) :rule trans :premises (@p10 @p9))
(step @p12 (= @t4 @t13) :rule cong :premises (@p11) :args (@t4))
(step @p13 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p14 @t13 :rule eq_resolve :premises (@p13 @p12))
(step @p15 @t3 :rule and_elim :premises (@p1) :args (0))
(step @p16 @t7 :rule eq_resolve :premises (@p15 @p11))
(step @p17 false :rule contra :premises (@p16 @p14))
)
