(
(define @t1 () (@var "a" Int))
(define @t2 () (@var "x" Int))
(define @t3 () (lambda (@list @t2 @t1) (+ @t2 @t1)))
(define @t4 () (set.fold @t3 0 (set.singleton 7)))
(define @t5 () (= @t4 7))
(define @t6 () (not @t5))
(define @t7 () (not true))
(define @t8 () (= 7 7))
(define @t9 () (+ 7 0))
(define @t10 () (_ @t3 7 0))
(define @t11 () (= @t10 @t9))
(assume @p1 (and @t5 @t6))
(step @p2 (= @t7 false) :rule evaluate :args (@t7))
(step @p3 (= @t8 true) :rule evaluate :args (@t8))
(step @p4 @t8 :rule refl :args (7))
(step @p5 (= @t9 7) :rule evaluate :args (@t9))
(step @p6 @t11 :rule beta-reduce :args (@t11))
(step @p7 (= @t10 7) :rule trans :premises (@p6 @p5))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p8 (= @t4 @t10) :rule trust :premises () :args ((= @t4 @t10)))
(step @p9 @t5 :rule trans :premises (@p8 @p7))
(step @p10 (= @t5 @t8) :rule cong :premises (@p9 @p4) :args (@t5))
(step @p11 (= @t5 true) :rule trans :premises (@p10 @p3))
(step @p12 (= @t6 @t7) :rule cong :premises (@p11) :args (@t6))
(step @p13 (= @t6 false) :rule trans :premises (@p12 @p2))
(step @p14 @t6 :rule and_elim :premises (@p1) :args (1))
(step @p15 false :rule eq_resolve :premises (@p14 @p13))
)