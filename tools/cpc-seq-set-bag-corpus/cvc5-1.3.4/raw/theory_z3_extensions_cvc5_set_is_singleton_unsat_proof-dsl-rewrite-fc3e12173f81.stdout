unsat
(
(define @t1 () (set.singleton 7))
(define @t2 () (set.is_singleton @t1))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (set.choose @t1))
(define @t6 () (set.singleton @t5))
(define @t7 () (= @t6 @t1))
(define @t8 () (= @t1 @t6))
(assume @p1 (and @t2 @t3))
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 7) :rule sets-choose-singleton :args (7))
(step @p4 @t7 :rule cong :premises (@p3) :args (@t6))
(step @p5 (= @t7 true) :rule true_intro :premises (@p4))
(step @p6 (= @t8 @t7) :rule eq-symm :args (@t1 @t6))
(step @p7 (= @t8 true) :rule trans :premises (@p6 @p5))
(step @p8 (= @t2 @t8) :rule sets-is-singleton-elim :args (@t1))
(step @p9 (= @t2 true) :rule trans :premises (@p8 @p7))
(step @p10 (= @t3 @t4) :rule cong :premises (@p9) :args (@t3))
(step @p11 (= @t3 false) :rule trans :premises (@p10 @p2))
(step @p12 @t3 :rule and_elim :premises (@p1) :args (1))
(step @p13 false :rule eq_resolve :premises (@p12 @p11))
)
(
(define @t1 () (set.singleton 7))
(define @t2 () (set.is_singleton @t1))
(define @t3 () (not @t2))
(define @t4 () (not true))
(define @t5 () (set.choose @t1))
(define @t6 () (set.singleton @t5))
(define @t7 () (= @t6 @t1))
(define @t8 () (= @t1 @t6))
(assume @p1 (and @t2 @t3))
(step @p2 (= @t4 false) :rule evaluate :args (@t4))
(step @p3 (= @t5 7) :rule sets-choose-singleton :args (7))
(step @p4 @t7 :rule cong :premises (@p3) :args (@t6))
(step @p5 (= @t7 true) :rule true_intro :premises (@p4))
(step @p6 (= @t8 @t7) :rule eq-symm :args (@t1 @t6))
(step @p7 (= @t8 true) :rule trans :premises (@p6 @p5))
(step @p8 (= @t2 @t8) :rule sets-is-singleton-elim :args (@t1))
(step @p9 (= @t2 true) :rule trans :premises (@p8 @p7))
(step @p10 (= @t3 @t4) :rule cong :premises (@p9) :args (@t3))
(step @p11 (= @t3 false) :rule trans :premises (@p10 @p2))
(step @p12 @t3 :rule and_elim :premises (@p1) :args (1))
(step @p13 false :rule eq_resolve :premises (@p12 @p11))
)
