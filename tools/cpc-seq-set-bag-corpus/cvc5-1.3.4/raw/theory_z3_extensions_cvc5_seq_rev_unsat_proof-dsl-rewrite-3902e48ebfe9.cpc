(
(define @t1 () (seq.unit 1))
(define @t2 () (seq.unit 2))
(define @t3 () (seq.++ @t2 @t1))
(define @t4 () (seq.++ @t1 @t2))
(define @t5 () (seq.rev @t4))
(define @t6 () (= @t5 @t3))
(define @t7 () (not @t6))
(define @t8 () (not true))
(define @t9 () (= @t3 @t3))
(define @t10 () (= @t1 @t1))
(define @t11 () (= @t2 @t2))
(define @t12 () (= @t4 @t4))
(assume @p1 (and @t6 @t7))
(step @p2 (= @t8 false) :rule evaluate :args (@t8))
(step @p3 (= @t9 true) :rule eq-refl :args (@t3))
(step @p4 @t9 :rule seq-eval-op :args (@t9))
(step @p5 @t10 :rule seq-eval-op :args (@t10))
(step @p6 @t11 :rule seq-eval-op :args (@t11))
(step @p7 @t9 :rule nary_cong :premises (@p6 @p5) :args (@t3))
(step @p8 @t9 :rule trans :premises (@p7 @p4))
(step @p9 @t6 :rule seq-eval-op :args (@t6))
(step @p10 @t12 :rule seq-eval-op :args (@t12))
(step @p11 @t12 :rule nary_cong :premises (@p5 @p6) :args (@t4))
(step @p12 @t12 :rule trans :premises (@p11 @p10))
(step @p13 (= @t5 @t5) :rule cong :premises (@p12) :args (@t5))
(step @p14 @t6 :rule trans :premises (@p13 @p9))
(step @p15 (= @t6 @t9) :rule cong :premises (@p14 @p8) :args (@t6))
(step @p16 (= @t6 true) :rule trans :premises (@p15 @p3))
(step @p17 (= @t7 @t8) :rule cong :premises (@p16) :args (@t7))
(step @p18 (= @t7 false) :rule trans :premises (@p17 @p2))
(step @p19 @t7 :rule and_elim :premises (@p1) :args (1))
(step @p20 false :rule eq_resolve :premises (@p19 @p18))
)