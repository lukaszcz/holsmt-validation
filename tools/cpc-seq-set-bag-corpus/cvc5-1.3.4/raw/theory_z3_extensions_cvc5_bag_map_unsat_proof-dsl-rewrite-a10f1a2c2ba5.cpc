(
(define @t1 () (bag 7 2))
(define @t2 () (@var "x" Int))
(define @t3 () (lambda (@list @t2) @t2))
(define @t4 () (bag.map @t3 @t1))
(define @t5 () (bag.count 7 @t4))
(define @t6 () (= @t5 2))
(define @t7 () (not @t6))
(define @t8 () (not true))
(define @t9 () (= 2 2))
(define @t10 () (bag.count 7 @t1))
(define @t11 () (_ @t3 7))
(define @t12 () (= @t11 7))
(define @t13 () (bag @t11 2))
(assume @p1 (and @t6 @t7))
(step @p2 (= @t8 false) :rule evaluate :args (@t8))
(step @p3 (= @t9 true) :rule evaluate :args (@t9))
(step @p4 @t9 :rule refl :args (2))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p5 (= @t10 2) :rule trust :premises () :args ((= @t10 2)))
(step @p6 @t12 :rule beta-reduce :args (@t12))
(step @p7 (= @t13 @t1) :rule cong :premises (@p6 @p4) :args (@t13))
; trust TRUST_THEORY_REWRITE
(step @p8 (= @t4 @t13) :rule trust :premises () :args ((= @t4 @t13)))
(step @p9 (= @t4 @t1) :rule trans :premises (@p8 @p7))
(step @p10 (= 7 7) :rule refl :args (7))
(step @p11 (= @t5 @t10) :rule cong :premises (@p10 @p9) :args (@t5))
(step @p12 @t6 :rule trans :premises (@p11 @p5))
(step @p13 (= @t6 @t9) :rule cong :premises (@p12 @p4) :args (@t6))
(step @p14 (= @t6 true) :rule trans :premises (@p13 @p3))
(step @p15 (= @t7 @t8) :rule cong :premises (@p14) :args (@t7))
(step @p16 (= @t7 false) :rule trans :premises (@p15 @p2))
(step @p17 @t7 :rule and_elim :premises (@p1) :args (1))
(step @p18 false :rule eq_resolve :premises (@p17 @p16))
)