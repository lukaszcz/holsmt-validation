unsat
(
(declare-const x (Seq Int))
(declare-const y (Seq Int))
(define @t1 () (distinct x y))
(define @t2 () (not @t1))
(define @t3 () (= x y))
(define @t4 () (not @t3))
(define @t5 () (= @t1 @t4))
(define @t6 () (not @t4))
(assume @p1 (and @t1 @t2))
(step @p2 @t5 :rule distinct-elim :args (@t5))
(step @p3 @t1 :rule and_elim :premises (@p1) :args (0))
(step @p4 @t4 :rule eq_resolve :premises (@p3 @p2))
(step @p5 (= @t6 @t3) :rule bool-double-not-elim :args (@t3))
(step @p6 (= @t2 @t6) :rule cong :premises (@p2) :args (@t2))
(step @p7 (= @t2 @t3) :rule trans :premises (@p6 @p5))
(step @p8 @t2 :rule and_elim :premises (@p1) :args (1))
(step @p9 @t3 :rule eq_resolve :premises (@p8 @p7))
(step @p10 false :rule contra :premises (@p9 @p4))
)
(
(declare-const x (Seq Int))
(declare-const y (Seq Int))
(define @t1 () (distinct x y))
(define @t2 () (not @t1))
(define @t3 () (= x y))
(define @t4 () (not @t3))
(define @t5 () (= @t1 @t4))
(define @t6 () (not @t4))
(assume @p1 (and @t1 @t2))
(step @p2 @t5 :rule distinct-elim :args (@t5))
(step @p3 @t1 :rule and_elim :premises (@p1) :args (0))
(step @p4 @t4 :rule eq_resolve :premises (@p3 @p2))
(step @p5 (= @t6 @t3) :rule bool-double-not-elim :args (@t3))
(step @p6 (= @t2 @t6) :rule cong :premises (@p2) :args (@t2))
(step @p7 (= @t2 @t3) :rule trans :premises (@p6 @p5))
(step @p8 @t2 :rule and_elim :premises (@p1) :args (1))
(step @p9 @t3 :rule eq_resolve :premises (@p8 @p7))
(step @p10 false :rule contra :premises (@p9 @p4))
)
