(
(declare-const cs (Set Int))
(define @t1 () (distinct (as set.universe (Set Int)) cs))
(define @t2 () (not @t1))
(define @t3 () (= cs (as set.universe (Set Int))))
(define @t4 () (= (as set.universe (Set Int)) cs))
(define @t5 () (not @t3))
(define @t6 () (not @t4))
(define @t7 () (= @t1 @t6))
(define @t8 () (not @t5))
(assume @p1 (and @t1 @t2))
(step @p2 (= @t4 @t3) :rule eq-symm :args ((as set.universe (Set Int)) cs))
(step @p3 (= @t6 @t5) :rule cong :premises (@p2) :args (@t6))
(step @p4 @t7 :rule distinct-elim :args (@t7))
(step @p5 (= @t1 @t5) :rule trans :premises (@p4 @p3))
(step @p6 @t1 :rule and_elim :premises (@p1) :args (0))
(step @p7 @t5 :rule eq_resolve :premises (@p6 @p5))
(step @p8 (= @t8 @t3) :rule bool-double-not-elim :args (@t3))
(step @p9 (= @t2 @t8) :rule cong :premises (@p5) :args (@t2))
(step @p10 (= @t2 @t3) :rule trans :premises (@p9 @p8))
(step @p11 @t2 :rule and_elim :premises (@p1) :args (1))
(step @p12 @t3 :rule eq_resolve :premises (@p11 @p10))
(step @p13 false :rule contra :premises (@p12 @p7))
)