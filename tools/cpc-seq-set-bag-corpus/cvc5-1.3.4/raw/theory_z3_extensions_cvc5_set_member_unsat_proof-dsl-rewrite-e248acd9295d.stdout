unsat
(
(define @t1 () (set.member 7 (set.singleton 7)))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (= 7 7))
(assume @p1 (and @t1 @t2))
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t1 @t4) :rule sets-member-singleton :args (7 7))
(step @p5 (= @t1 true) :rule trans :premises (@p4 @p3))
(step @p6 (= @t2 @t3) :rule cong :premises (@p5) :args (@t2))
(step @p7 (= @t2 false) :rule trans :premises (@p6 @p2))
(step @p8 @t2 :rule and_elim :premises (@p1) :args (1))
(step @p9 false :rule eq_resolve :premises (@p8 @p7))
)
(
(define @t1 () (set.member 7 (set.singleton 7)))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (= 7 7))
(assume @p1 (and @t1 @t2))
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 (= @t1 @t4) :rule sets-member-singleton :args (7 7))
(step @p5 (= @t1 true) :rule trans :premises (@p4 @p3))
(step @p6 (= @t2 @t3) :rule cong :premises (@p5) :args (@t2))
(step @p7 (= @t2 false) :rule trans :premises (@p6 @p2))
(step @p8 @t2 :rule and_elim :premises (@p1) :args (1))
(step @p9 false :rule eq_resolve :premises (@p8 @p7))
)
