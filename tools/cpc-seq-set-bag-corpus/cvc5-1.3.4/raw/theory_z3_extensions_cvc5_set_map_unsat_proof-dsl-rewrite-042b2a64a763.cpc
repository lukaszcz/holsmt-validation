(
(define @t1 () (set.singleton 7))
(define @t2 () (@var "x" Int))
(define @t3 () (lambda (@list @t2) @t2))
(define @t4 () (set.map @t3 @t1))
(define @t5 () (set.member 7 @t4))
(define @t6 () (not @t5))
(define @t7 () (not true))
(define @t8 () (= 7 7))
(define @t9 () (set.member 7 @t1))
(define @t10 () (_ @t3 7))
(define @t11 () (= @t10 7))
(define @t12 () (set.singleton @t10))
(assume @p1 (and @t5 @t6))
(step @p2 (= @t7 false) :rule evaluate :args (@t7))
(step @p3 (= @t8 true) :rule evaluate :args (@t8))
(step @p4 (= @t9 @t8) :rule sets-member-singleton :args (7 7))
(step @p5 (= @t9 true) :rule trans :premises (@p4 @p3))
(step @p6 @t11 :rule beta-reduce :args (@t11))
(step @p7 (= @t12 @t1) :rule cong :premises (@p6) :args (@t12))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p8 (= @t4 @t12) :rule trust :premises () :args ((= @t4 @t12)))
(step @p9 (= @t4 @t1) :rule trans :premises (@p8 @p7))
(step @p10 @t8 :rule refl :args (7))
(step @p11 (= @t5 @t9) :rule cong :premises (@p10 @p9) :args (@t5))
(step @p12 (= @t5 true) :rule trans :premises (@p11 @p5))
(step @p13 (= @t6 @t7) :rule cong :premises (@p12) :args (@t6))
(step @p14 (= @t6 false) :rule trans :premises (@p13 @p2))
(step @p15 @t6 :rule and_elim :premises (@p1) :args (1))
(step @p16 false :rule eq_resolve :premises (@p15 @p14))
)