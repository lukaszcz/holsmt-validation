unsat
(
(declare-const cb (Bag Int))
(declare-const hp (-> Int Bool))
(declare-const cc (Bag Int))
(define @t1 () (bag.some hp cc))
(define @t2 () (bag.some hp cb))
(define @t3 () (= @t2 @t1))
(define @t4 () (not @t3))
(define @t5 () (bag.filter hp cc))
(define @t6 () (= (as bag.empty (Bag Int)) @t5))
(define @t7 () (= @t5 (as bag.empty (Bag Int))))
(define @t8 () (not @t6))
(define @t9 () (not @t7))
(define @t10 () (not (= (bag.filter hp cb) (as bag.empty (Bag Int)))))
(define @t11 () (= @t10 @t8))
(define @t12 () (not @t11))
(assume @p1 (and @t3 @t4))
(step @p2 (= @t7 @t6) :rule eq-symm :args (@t5 (as bag.empty (Bag Int))))
(step @p3 (= @t9 @t8) :rule cong :premises (@p2) :args (@t9))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p4 (= @t1 @t9) :rule trust :premises () :args ((= @t1 @t9)))
(step @p5 (= @t1 @t8) :rule trans :premises (@p4 @p3))
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t2 @t10) :rule trust :premises () :args ((= @t2 @t10)))
(step @p7 (= @t3 @t11) :rule cong :premises (@p6 @p5) :args (@t3))
(step @p8 (= @t4 @t12) :rule cong :premises (@p7) :args (@t4))
(step @p9 @t4 :rule and_elim :premises (@p1) :args (1))
(step @p10 @t12 :rule eq_resolve :premises (@p9 @p8))
(step @p11 @t3 :rule and_elim :premises (@p1) :args (0))
(step @p12 @t11 :rule eq_resolve :premises (@p11 @p7))
(step @p13 false :rule contra :premises (@p12 @p10))
)
(
(declare-const cb (Bag Int))
(declare-const hp (-> Int Bool))
(declare-const cc (Bag Int))
(define @t1 () (bag.some hp cc))
(define @t2 () (bag.some hp cb))
(define @t3 () (= @t2 @t1))
(define @t4 () (not @t3))
(define @t5 () (bag.filter hp cc))
(define @t6 () (= (as bag.empty (Bag Int)) @t5))
(define @t7 () (= @t5 (as bag.empty (Bag Int))))
(define @t8 () (not @t6))
(define @t9 () (not @t7))
(define @t10 () (not (= (bag.filter hp cb) (as bag.empty (Bag Int)))))
(define @t11 () (= @t10 @t8))
(define @t12 () (not @t11))
