; trust TRUST_THEORY_REWRITE
(step @p4 (= @t1 @t9) :rule trust :premises () :args ((= @t1 @t9)))
(step @p5 (= @t1 @t8) :rule trans :premises (@p4 @p3))
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t2 @t10) :rule trust :premises () :args ((= @t2 @t10)))
(step @p7 (= @t3 @t11) :rule cong :premises (@p6 @p5) :args (@t3))
(step @p8 (= @t4 @t12) :rule cong :premises (@p7) :args (@t4))
(step @p9 @t4 :rule and_elim :premises (@p1) :args (1))
