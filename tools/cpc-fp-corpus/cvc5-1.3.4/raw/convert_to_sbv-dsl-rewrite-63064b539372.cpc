(
(define @t1 () (= (fp.to_sbv 4 roundTowardZero (fp #b1 #b100 #b1000)) #b1101))
(define @t2 () (not @t1))
(define @t3 () (not true))
(define @t4 () (= #b1101 #b1101))
(assume @p1 @t2)
(step @p2 (= @t3 false) :rule evaluate :args (@t3))
(step @p3 (= @t4 true) :rule evaluate :args (@t4))
(step @p4 @t4 :rule refl :args (#b1101))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p5 @t1 :rule trust :premises () :args (@t1))
(step @p6 (= @t1 @t4) :rule cong :premises (@p5 @p4) :args (@t1))
(step @p7 (= @t1 true) :rule trans :premises (@p6 @p3))
(step @p8 (= @t2 @t3) :rule cong :premises (@p7) :args (@t2))
(step @p9 (= @t2 false) :rule trans :premises (@p8 @p2))
(step @p10 false :rule eq_resolve :premises (@p1 @p9))
)