unsat
(
(define @t1 () (/ 33/1 32/1))
(define @t2 () (to_fp 4 7 roundNearestTiesToEven @t1))
(define @t3 () (to_fp 3 5 roundNearestTiesToAway @t2))
(define @t4 () (= @t3 (fp #b0 #b011 #b0001)))
(define @t5 () (not @t4))
(define @t6 () (not true))
(define @t7 () (= (fp #b0 #b011 #b0001) (fp #b0 #b011 #b0001)))
(define @t8 () (to_fp 3 5 roundNearestTiesToAway (fp #b0 #b0111 #b000010)))
(define @t9 () (to_fp 4 7 roundNearestTiesToEven 33/32))
(assume @p1 @t5)
(step @p2 (= @t6 false) :rule evaluate :args (@t6))
(step @p3 (= @t7 true) :rule eq-refl :args ((fp #b0 #b011 #b0001)))
(step @p4 @t7 :rule refl :args ((fp #b0 #b011 #b0001)))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p5 (= @t8 (fp #b0 #b011 #b0001)) :rule trust :premises () :args ((= @t8 (fp #b0 #b011 #b0001))))
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t9 (fp #b0 #b0111 #b000010)) :rule trust :premises () :args ((= @t9 (fp #b0 #b0111 #b000010))))
(step @p7 (= @t1 33/32) :rule evaluate :args (@t1))
(step @p8 (= roundNearestTiesToEven roundNearestTiesToEven) :rule refl :args (roundNearestTiesToEven))
(step @p9 (= @t2 @t9) :rule cong :premises (@p8 @p7) :args (@t2))
(step @p10 (= @t2 (fp #b0 #b0111 #b000010)) :rule trans :premises (@p9 @p6))
(step @p11 (= roundNearestTiesToAway roundNearestTiesToAway) :rule refl :args (roundNearestTiesToAway))
(step @p12 (= @t3 @t8) :rule cong :premises (@p11 @p10) :args (@t3))
(step @p13 @t4 :rule trans :premises (@p12 @p5))
(step @p14 (= @t4 @t7) :rule cong :premises (@p13 @p4) :args (@t4))
(step @p15 (= @t4 true) :rule trans :premises (@p14 @p3))
(step @p16 (= @t5 @t6) :rule cong :premises (@p15) :args (@t5))
(step @p17 (= @t5 false) :rule trans :premises (@p16 @p2))
(step @p18 false :rule eq_resolve :premises (@p1 @p17))
)
