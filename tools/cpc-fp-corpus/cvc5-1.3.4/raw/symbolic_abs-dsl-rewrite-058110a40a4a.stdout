(step @p35 @t42 :rule reordering :premises (@p34) :args (@t42))
(step @p36 @t13 :rule chain_m_resolution :premises (@p35 @p33) :args (@t13 @t8 (@list @t15)))
(step @p37 (or @t41 @t9) :rule cnf_and_pos :args (@t15 2))
