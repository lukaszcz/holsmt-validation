(step @p21 (= @t3 @t17) :rule trans :premises (@p20 @p17))
(step @p22 (= @t4 @t4) :rule refl :args (@t4))
(step @p23 (= @t5 @t22) :rule cong :premises (@p22 @p21) :args (@t5))
(step @p24 (= @t6 @t23) :rule cong :premises (@p23) :args (@t6))
(step @p25 @t23 :rule eq_resolve :premises (@p1 @p24))
