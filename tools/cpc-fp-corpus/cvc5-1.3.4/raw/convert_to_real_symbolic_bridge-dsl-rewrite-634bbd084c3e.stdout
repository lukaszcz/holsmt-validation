unsat
(
(declare-const x (_ FloatingPoint 8 24))
(declare-const r Real)
(define @t1 () (fp.to_real x))
(define @t2 () (+ @t1 r))
(define @t3 () (<= @t2 r))
(define @t4 () (= x (fp #b0 #b00000000 #b00000000000000000000000)))
(define @t5 () (=> @t4 @t3))
(define @t6 () (not @t5))
(define @t7 () (not true))
(define @t8 () (>= 0/1 0/1))
(define @t9 () (= 0/1 0/1))
(define @t10 () (* -1/1 0/1))
(define @t11 () (fp.to_real (fp #b0 #b00000000 #b00000000000000000000000)))
(define @t12 () (= -1/1 -1/1))
(define @t13 () (* -1/1 @t11))
(define @t14 () (>= @t13 0/1))
(define @t15 () (not @t14))
(define @t16 () (* -1/1 @t1))
(define @t17 () (+ r @t1))
(define @t18 () (= (* -1/1 (- r @t17)) (* -1/1 (- @t16 0/1))))
(define @t19 () (>= @t16 0/1))
(define @t20 () (>= r @t17))
(define @t21 () (= @t20 @t19))
(define @t22 () (<= @t17 r))
(define @t23 () (= @t2 @t17))
(define @t24 () (=> @t4 @t19))
(define @t25 () (not @t24))
(define @t26 () (not @t19))
(assume @p1 @t6)
(step @p2 (= @t7 false) :rule evaluate :args (@t7))
(step @p3 (= @t8 true) :rule evaluate :args (@t8))
(step @p4 @t9 :rule refl :args (0/1))
(step @p5 (= @t10 0/1) :rule evaluate :args (@t10))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p6 (= @t11 0/1) :rule trust :premises () :args ((= @t11 0/1)))
(step @p7 @t12 :rule refl :args (-1/1))
(step @p8 (= @t13 @t10) :rule nary_cong :premises (@p7 @p6) :args (@t13))
(step @p9 (= @t13 0/1) :rule trans :premises (@p8 @p5))
(step @p10 (= @t14 @t8) :rule cong :premises (@p9 @p4) :args (@t14))
(step @p11 (= @t14 true) :rule trans :premises (@p10 @p3))
(step @p12 (= @t15 @t7) :rule cong :premises (@p11) :args (@t15))
(step @p13 (= @t15 false) :rule trans :premises (@p12 @p2))
(step @p14 @t9 :rule refl :args (0/1))
(step @p15 @t18 :rule arith_poly_norm :args (@t18))
(step @p16 @t21 :rule arith_poly_norm_rel :premises (@p15) :args (@t21))
(step @p17 (= @t22 @t20) :rule arith-elim-leq :args (@t17 r))
(step @p18 (= @t22 @t19) :rule trans :premises (@p17 @p16))
(step @p19 (= r r) :rule refl :args (r))
(step @p20 @t23 :rule arith_poly_norm :args (@t23))
(step @p21 (= @t3 @t22) :rule cong :premises (@p20 @p19) :args (@t3))
(step @p22 (= @t3 @t19) :rule trans :premises (@p21 @p18))
(step @p23 (= @t4 @t4) :rule refl :args (@t4))
(step @p24 (= @t5 @t24) :rule cong :premises (@p23 @p22) :args (@t5))
(step @p25 (= @t6 @t25) :rule cong :premises (@p24) :args (@t6))
(step @p26 @t25 :rule eq_resolve :premises (@p1 @p25))
(step @p27 @t4 :rule not_implies_elim1 :premises (@p26))
(step @p28 (= @t1 @t11) :rule cong :premises (@p27) :args (@t1))
(step @p29 @t12 :rule refl :args (-1/1))
(step @p30 (= @t16 @t13) :rule nary_cong :premises (@p29 @p28) :args (@t16))
(step @p31 (= @t19 @t14) :rule cong :premises (@p30 @p14) :args (@t19))
(step @p32 (= @t26 @t15) :rule cong :premises (@p31) :args (@t26))
(step @p33 (= @t26 false) :rule trans :premises (@p32 @p13))
(step @p34 @t26 :rule not_implies_elim2 :premises (@p26))
(step @p35 false :rule eq_resolve :premises (@p34 @p33))
)
