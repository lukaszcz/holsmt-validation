(step @p29 (= @t17 @t12) :rule cong :premises (@p28 @p4) :args (@t17))
(step @p30 (= @t24 @t13) :rule cong :premises (@p29) :args (@t24))
(step @p31 (= @t24 false) :rule trans :premises (@p30 @p13))
