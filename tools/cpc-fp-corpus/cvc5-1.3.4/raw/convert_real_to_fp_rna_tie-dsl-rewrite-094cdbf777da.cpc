(
(define @t1 () (/ 33/1 32/1))
(define @t2 () (to_fp 3 5 roundNearestTiesToAway @t1))
(define @t3 () (= @t2 (fp #b0 #b011 #b0001)))
(define @t4 () (not @t3))
(define @t5 () (not true))
(define @t6 () (= (fp #b0 #b011 #b0001) (fp #b0 #b011 #b0001)))
(define @t7 () (to_fp 3 5 roundNearestTiesToAway 33/32))
(assume @p1 @t4)
(step @p2 (= @t5 false) :rule evaluate :args (@t5))
(step @p3 (= @t6 true) :rule eq-refl :args ((fp #b0 #b011 #b0001)))
(step @p4 @t6 :rule refl :args ((fp #b0 #b011 #b0001)))
; WARNING: add trust step for TRUST_THEORY_REWRITE
; trust TRUST_THEORY_REWRITE
(step @p5 (= @t7 (fp #b0 #b011 #b0001)) :rule trust :premises () :args ((= @t7 (fp #b0 #b011 #b0001))))
(step @p6 (= @t1 33/32) :rule evaluate :args (@t1))
(step @p7 (= roundNearestTiesToAway roundNearestTiesToAway) :rule refl :args (roundNearestTiesToAway))
(step @p8 (= @t2 @t7) :rule cong :premises (@p7 @p6) :args (@t2))
(step @p9 @t3 :rule trans :premises (@p8 @p5))
(step @p10 (= @t3 @t6) :rule cong :premises (@p9 @p4) :args (@t3))
(step @p11 (= @t3 true) :rule trans :premises (@p10 @p3))
(step @p12 (= @t4 @t5) :rule cong :premises (@p11) :args (@t4))
(step @p13 (= @t4 false) :rule trans :premises (@p12 @p2))
(step @p14 false :rule eq_resolve :premises (@p1 @p13))
)