(
(declare-const x (_ FloatingPoint 3 5))
(define @t1 () (fp.isPositive x))
(define @t2 () (fp.isNaN x))
(define @t3 () (@fp.NAN (_ BitVec 1)))
(define @t4 () (= #b1 @t3))
(define @t5 () (@list false))
(define @t6 () (@bit 0 @t3))
(define @t7 () (= @t6 true))
(define @t8 () (= true @t6))
(define @t9 () (@from_bools @t6))
(define @t10 () (@from_bools true))
(define @t11 () (= @t10 @t9))
(define @t12 () (= @t11 @t8))
(define @t13 () (= @t3 @t9))
(define @t14 () (= #b1 @t10))
(define @t15 () (@fp.SIGN (_ BitVec 1)))
(define @t16 () (bvnot @t15))
(define @t17 () (bvnot @t3))
(define @t18 () (bvand @t17 @t16))
(define @t19 () (= #b1 @t18))
(define @t20 () (@bit 0 @t15))
(define @t21 () (not @t20))
(define @t22 () (not @t6))
(define @t23 () (and @t22 @t21))
(define @t24 () (= @t23 true))
(define @t25 () (= true @t23))
(define @t26 () (@from_bools @t23))
(define @t27 () (= @t10 @t26))
(define @t28 () (= @t27 @t25))
(define @t29 () (@from_bools @t21))
(define @t30 () (@from_bools @t22))
(define @t31 () (bvand @t30 @t29))
(define @t32 () (= @t31 @t26))
(define @t33 () (@from_bools @t20))
(define @t34 () (bvnot @t33))
(define @t35 () (= @t34 @t29))
(define @t36 () (= @t15 @t33))
(define @t37 () (bvnot @t9))
(define @t38 () (= @t37 @t30))
(define @t39 () (not @t23))
(define @t40 () (or @t22 @t39))
(assume @p1 (and @t2 @t1))
(step @p2 @t2 :rule and_elim :premises (@p1) :args (0))
; WARNING: add trust step for TRUST
; trust TRUST THEORY_LEMMA
(step @p3 (= @t2 @t4) :rule trust :premises () :args ((= @t2 @t4)))
(step @p4 (or (not @t2) @t4) :rule equiv_elim1 :premises (@p3))
(step @p5 @t4 :rule chain_m_resolution :premises (@p4 @p2) :args (@t4 @t5 (@list @t2)))
(step @p6 (= @t7 @t6) :rule bool-eq-true :args (@t6))
(step @p7 (= @t8 @t7) :rule eq-symm :args (true @t6))
(step @p8 (= @t8 @t6) :rule trans :premises (@p7 @p6))
(step @p9 @t12 :rule bv_bitblast_step :args (@t12))
(step @p10 @t13 :rule bv_bitblast_step :args (@t13))
(step @p11 @t14 :rule bv_bitblast_step :args (@t14))
(step @p12 (= @t4 @t11) :rule cong :premises (@p11 @p10) :args (@t4))
(step @p13 (= @t4 @t8) :rule trans :premises (@p12 @p9))
(step @p14 (= @t4 @t6) :rule trans :premises (@p13 @p8))
(step @p15 (or (not @t4) @t6) :rule equiv_elim1 :premises (@p14))
(step @p16 @t6 :rule chain_m_resolution :premises (@p15 @p5) :args (@t6 @t5 (@list @t4)))
(step @p17 @t1 :rule and_elim :premises (@p1) :args (1))
; trust TRUST THEORY_LEMMA
(step @p18 (= @t1 @t19) :rule trust :premises () :args ((= @t1 @t19)))
(step @p19 (or (not @t1) @t19) :rule equiv_elim1 :premises (@p18))
(step @p20 @t19 :rule chain_m_resolution :premises (@p19 @p17) :args (@t19 @t5 (@list @t1)))
(step @p21 (= @t24 @t23) :rule bool-eq-true :args (@t23))
(step @p22 (= @t25 @t24) :rule eq-symm :args (true @t23))
(step @p23 (= @t25 @t23) :rule trans :premises (@p22 @p21))
(step @p24 @t28 :rule bv_bitblast_step :args (@t28))
(step @p25 @t32 :rule bv_bitblast_step :args (@t32))
(step @p26 @t35 :rule bv_bitblast_step :args (@t35))
(step @p27 @t36 :rule bv_bitblast_step :args (@t36))
(step @p28 (= @t16 @t34) :rule cong :premises (@p27) :args (@t16))
(step @p29 (= @t16 @t29) :rule trans :premises (@p28 @p26))
(step @p30 @t38 :rule bv_bitblast_step :args (@t38))
(step @p31 (= @t17 @t37) :rule cong :premises (@p10) :args (@t17))
(step @p32 (= @t17 @t30) :rule trans :premises (@p31 @p30))
(step @p33 (= @t18 @t31) :rule nary_cong :premises (@p32 @p29) :args (@t18))
(step @p34 (= @t18 @t26) :rule trans :premises (@p33 @p25))
(step @p35 (= @t19 @t27) :rule cong :premises (@p11 @p34) :args (@t19))
(step @p36 (= @t19 @t25) :rule trans :premises (@p35 @p24))
(step @p37 (= @t19 @t23) :rule trans :premises (@p36 @p23))
(step @p38 (or (not @t19) @t23) :rule equiv_elim1 :premises (@p37))
(step @p39 @t23 :rule chain_m_resolution :premises (@p38 @p20) :args (@t23 @t5 (@list @t19)))
(step @p40 (or @t39 @t22) :rule cnf_and_pos :args (@t23 0))
(step @p41 @t40 :rule reordering :premises (@p40) :args (@t40))
(step @p42 false :rule chain_m_resolution :premises (@p41 @p39 @p16) :args (false (@list false false) (@list @t23 @t6)))
)